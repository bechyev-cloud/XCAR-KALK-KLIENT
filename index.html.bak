}
html[data-ui-style="new"] .page2HeaderBtns .notifyBellBadge{
  min-width:14px!important;height:14px!important;line-height:14px!important;
  font-size:8px!important;padding:0 3px!important;top:-4px!important;right:-4px!important;
  border:2px solid #173d54!important;
  box-shadow:0 3px 8px rgba(0,0,0,.20)!important;
}
html[data-ui-style="new"] .page2HeaderBtns .notesDot{
  width:6px!important;height:6px!important;top:3px!important;right:3px!important;
  border:1.5px solid #fff!important;
}
html[data-theme="dark"][data-ui-style="new"] .page2HeaderBtns > button{
  border-color:rgba(255,255,255,.25)!important;
  box-shadow:0 8px 18px rgba(0,0,0,.34),inset 0 1px 0 rgba(255,255,255,.18)!important;
}
@media(max-width:620px){
  html[data-ui-style="new"] .page2HeaderBtns{gap:6px!important}
  html[data-ui-style="new"] .page2HeaderBtns > button,
  html[data-ui-style="new"] .page2HeaderBtns .carAddTopBtn{
    width:34px!important;height:34px!important;min-width:34px!important;flex-basis:34px!important;border-radius:11px!important;
  }
