// ---------- уведомления в приложении: оформление и завершение аренды, суммы ----------
const NOTIFY_KEY="xcarAppNotifications";
let appNotifications=[];
function loadAppNotifications(){
try{
const raw=localStorage.getItem(NOTIFY_KEY);
appNotifications=raw?JSON.parse(raw):[];
if(!Array.isArray(appNotifications)) appNotifications=[];
}catch(e){appNotifications=[];}
}
function saveAppNotifications(){
try{localStorage.setItem(NOTIFY_KEY,JSON.stringify(appNotifications.slice(0,150)));}catch(e){}
}
function addAppNotification(entry){
appNotifications.unshift({
id:"n"+Date.now().toString(36)+Math.random().toString(36).slice(2,7),
type:entry.type,
car:entry.car,
sum:entry.sum||0,
sumLabel:entry.sumLabel||"",
text:entry.text||"",
ts:Date.now(),
read:false
});
saveAppNotifications();
renderNotifyBadge();
const btn=document.getElementById("notifyBellBtn");
if(btn){
btn.classList.remove("ring");
void btn.offsetWidth;
btn.classList.add("ring");
}
if(document.getElementById("notifyModal").classList.contains("open")) renderNotifyList();
}
function unreadNotifyCount(){return appNotifications.filter(n=>!n.read).length;}
function renderNotifyBadge(){
const badge=document.getElementById("notifyBellBadge");
if(!badge) return;
const n=unreadNotifyCount();
if(n>0){badge.style.display="flex";badge.textContent=n>99?"99+":String(n);}
else badge.style.display="none";
}
function fmtNotifyTime(ts){
const d=new Date(ts);
const pad=x=>("0"+x).slice(-2);
const now=new Date();
const sameDay=d.toDateString()===now.toDateString();
return (sameDay?"сегодня ":pad(d.getDate())+"."+pad(d.getMonth()+1)+" ")+pad(d.getHours())+":"+pad(d.getMinutes());
}
function renderNotifyList(){
const wrap=document.getElementById("notifyList");
if(!wrap) return;
if(!appNotifications.length){
wrap.innerHTML=`<div class="notifyEmpty"><div class="historyEmptyIcon">🔔</div>Пока нет уведомлений — здесь появятся оформления и завершения аренды</div>`;
return;
}
wrap.innerHTML="";
appNotifications.forEach(n=>{
const item=document.createElement("div");
item.className="notifyItem"+(n.read?"":" unread");
const isDone=n.type==="completed";
const isPush=n.type==="push";
item.innerHTML=isPush?
(`<div class="notifyIcon">📲</div>`+
`<div class="notifyBody">`+
`<div class="notifyTitle">${escapeHtml(n.text||"Событие на другом устройстве")}</div>`+
`<div class="notifyTime">${fmtNotifyTime(n.ts)}</div>`+
`</div>`):
(`<div class="notifyIcon">${isDone?"🏁":"🔑"}</div>`+
`<div class="notifyBody">`+
`<div class="notifyTitle">${isDone?"Аренда завершена":"Аренда оформлена"} — ${escapeHtml(n.car||"")}</div>`+
(n.sumLabel?`<div class="notifyDesc">${escapeHtml(n.sumLabel)}</div>`:"")+
`<div class="notifySum${isDone?" sumDone":""}">${space(Math.round(n.sum||0))} ₽</div>`+
`<div class="notifyTime">${fmtNotifyTime(n.ts)}</div>`+
`</div>`);
item.addEventListener("click",()=>{
if(!n.read){n.read=true;saveAppNotifications();renderNotifyBadge();item.classList.remove("unread");}
});
wrap.appendChild(item);
});
}
function markAllNotificationsRead(){
if(!appNotifications.length) return;
appNotifications.forEach(n=>n.read=true);
saveAppNotifications();
renderNotifyBadge();
renderNotifyList();
vibrate(10);
}
loadAppNotifications();
renderNotifyBadge();
document.getElementById("notifyBellBtn").addEventListener("click",()=>{
renderNotifyList();
document.getElementById("notifyModal").classList.add("open");
vibrate(8);
});
document.getElementById("notifyModalCloseBtn").addEventListener("click",()=>{
document.getElementById("notifyModal").classList.remove("open");
});
document.getElementById("notifyModal").addEventListener("click",e=>{
if(e.target.id==="notifyModal") document.getElementById("notifyModal").classList.remove("open");
});
document.getElementById("notifyMarkAllReadBtn").addEventListener("click",markAllNotificationsRead);
// при запуске приложения, если аккаунт подключён и push раньше был включён — незаметно
// продлеваем/восстанавливаем подписку (pushManager.subscribe на уже активной подписке
