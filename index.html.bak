});
document.getElementById("accountLogoutBtn").addEventListener("click",()=>{
showConfirm({
title:"Выйти из аккаунта?",
message:"Синхронизация будет остановлена. Локальные данные останутся, а логин, пароль и данные аккаунта будут сохранены на этом устройстве. Аккаунт и данные на сервере не удаляются.",
confirmText:"Выйти",
onConfirm:async()=>{
await unsubscribeFromPush();
settings.account.connected=false;
saveSettings();
renderAccountUI();
setAccountHint("Вы вышли из аккаунта. Данные аккаунта сохранены на устройстве.",false);
vibrate(15);
}
});
});
document.getElementById("accountDeleteBtn").addEventListener("click",()=>{
showConfirm({
title:"Удалить аккаунт с сервера?",
message:`Аккаунт «${settings.account.username}» и все синхронизированные данные будут удалены с сервера навсегда. Локальные данные на этом устройстве останутся.`,
confirmText:"Удалить",
onConfirm:async()=>{
await unsubscribeFromPush();
try{
await fetch(apiUrl("/api/account"),{
method:"DELETE",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({username:settings.account.username,password:settings.account.password})
});
}catch(e){}
settings.account.connected=false;
saveSettings();
renderAccountUI();
setAccountHint("Аккаунт удалён с сервера",false);
vibrate([20,40,20]);
}
});
});
renderAccountUI();

// ---------- автообновление данных с сервера — настраиваемый интервал 1–59 сек ----------
let autoSyncTimer=null;
function restartAutoSyncTimer(){
if(autoSyncTimer){clearInterval(autoSyncTimer);autoSyncTimer=null;}
if(settings.autoSyncEnabled===false) return;
const sec=Math.min(59,Math.max(1,parseInt(settings.autoSyncIntervalSec,10)||30));
autoSyncTimer=setInterval(()=>{
if(settings.account&&settings.account.connected&&!document.hidden) syncNow({silent:true});
},sec*1000);
}
restartAutoSyncTimer();
function renderAutoSyncUI(){
const check=document.getElementById("autoSyncToggleCheck");
if(check) check.checked=settings.autoSyncEnabled!==false;
const sec=Math.min(59,Math.max(1,parseInt(settings.autoSyncIntervalSec,10)||30));
const slider=document.getElementById("autoSyncIntervalSlider");
if(slider) slider.value=sec;
const valEl=document.getElementById("autoSyncIntervalValue");
if(valEl) valEl.textContent=sec;
const row=document.getElementById("autoSyncIntervalRow");
if(row) row.classList.toggle("disabled",settings.autoSyncEnabled===false);
const hint=document.getElementById("autoSyncFolderHint");
if(hint) hint.textContent=settings.autoSyncEnabled===false?"Выключено":`Каждые ${sec} сек`;
}
document.getElementById("autoSyncToggleCheck").addEventListener("change",(e)=>{
settings.autoSyncEnabled=e.target.checked;
saveSettings();
restartAutoSyncTimer();
renderAutoSyncUI();
vibrate(12);
});
document.getElementById("autoSyncIntervalSlider").addEventListener("input",(e)=>{
const sec=Math.min(59,Math.max(1,parseInt(e.target.value,10)||30));
document.getElementById("autoSyncIntervalValue").textContent=sec;
});
document.getElementById("autoSyncIntervalSlider").addEventListener("change",(e)=>{
settings.autoSyncIntervalSec=Math.min(59,Math.max(1,parseInt(e.target.value,10)||30));
saveSettings();
restartAutoSyncTimer();
renderAutoSyncUI();
vibrate(8);
});

if(settings.account&&settings.account.connected){
setTimeout(()=>syncNow({}),1200);
}

// ---------- потяните вниз в меню, чтобы синхронизироваться с сервером ----------
// ---------- блокировка прокрутки фона, пока открыта шторка/модалка ----------
// без этого свайп вниз внутри списка (когда список долистан до верха) "проваливался"
// в фон под шторкой, а на телефоне это доходило до нативного жеста браузера
// "потянуть чтобы обновить страницу" — вся страница перезагружалась и человека
// как будто "выбрасывало" из раздела, в котором он находился. Плюс overscroll-behavior
// в CSS выше — это два независимых слоя защиты от одной и той же проблемы.
(function setupBodyScrollLock(){
const WATCH_SELECTOR="#historyDrawer,#page2Drawer,.modalOverlay";
let savedScrollY=0,locked=false;
// аппаратная/жестовая кнопка "назад" на Android: пока открыта шторка или модалка,
// добавляем запись в историю браузера за КАЖДЫЙ дополнительно открытый слой (например
// уведомления открыты поверх уже открытого меню) — тогда каждое нажатие "назад"
// закрывает ровно один верхний слой, а не выбрасывает из приложения целиком
let closingFromPopstate=false,lastOpenCount=0,programmaticPop=false;
function isAnyOpen(){
return currentOpenCount()>0;
}
function currentOpenCount(){
return document.querySelectorAll(WATCH_SELECTOR+".open").length;
}
function closeTopOverlay(){
const openModal=document.querySelector(".modalOverlay.open");
if(openModal){openModal.classList.remove("open");return;}
const page2=document.getElementById("page2Drawer");
if(page2&&page2.classList.contains("open")){if(typeof closePage2==="function") closePage2(); else page2.classList.remove("open");return;}
const hist=document.getElementById("historyDrawer");
if(hist&&hist.classList.contains("open")){if(typeof closeHistory==="function") closeHistory(); else hist.classList.remove("open");return;}
}
window.addEventListener("popstate",()=>{
// если это НАШ СОБСТВЕННЫЙ вызов history.back()/go() для синхронизации счётчика
// (например, окно закрыли кнопкой "Сохранить", а не аппаратной кнопкой "назад") —
// DOM уже в правильном состоянии, ничего закрывать повторно не нужно
if(programmaticPop){
programmaticPop=false;
return;
}
if(isAnyOpen()){
closingFromPopstate=true;
closeTopOverlay();
Promise.resolve().then(()=>{closingFromPopstate=false;});
}
});
function syncHistory(){
const count=currentOpenCount();
if(count>lastOpenCount){
for(let i=lastOpenCount;i<count;i++){
try{window.history.pushState({xcarOverlay:true},"");}catch(e){}
}
lastOpenCount=count;
}else if(count<lastOpenCount){
const diff=lastOpenCount-count;
lastOpenCount=count;
if(!closingFromPopstate){
// окно(а) закрыты не аппаратной кнопкой "назад" (например кнопкой "Сохранить"/"Отмена"),
// значит нужно самим "откатить" лишние записи истории, иначе в следующий раз кнопка
// "назад" сначала откроет заново уже закрытое окно. go(-N) откатывает сразу на N шагов
// одним переходом (и одним событием popstate), поэтому достаточно одного programmaticPop
try{
programmaticPop=true;
if(diff===1) window.history.back();
else window.history.go(-diff);
}catch(e){programmaticPop=false;}
}
}
}
function applyLock(){
const shouldLock=isAnyOpen();
if(shouldLock&&!locked){
locked=true;
savedScrollY=window.scrollY||window.pageYOffset||0;
document.body.style.position="fixed";
document.body.style.top=(-savedScrollY)+"px";
document.body.style.left="0";
document.body.style.right="0";
document.body.style.width="100%";
}else if(!shouldLock&&locked){
locked=false;
document.body.style.position="";
document.body.style.top="";
document.body.style.left="";
document.body.style.right="";
document.body.style.width="";
window.scrollTo(0,savedScrollY);
}
syncHistory();
}
const watched=document.querySelectorAll(WATCH_SELECTOR);
if(!watched.length) return;
const mo=new MutationObserver(applyLock);
watched.forEach(el=>mo.observe(el,{attributes:true,attributeFilter:["class"]}));
applyLock();
})();

(function setupPullToRefresh(){
const content=document.getElementById("page2Content");
const indicator=document.getElementById("pullRefreshIndicator");
const icon=document.getElementById("pullRefreshIcon");
const label=document.getElementById("pullRefreshLabel");
if(!content||!indicator) return;
const MAX=56,THRESHOLD=54;
let startY=0,pulling=false,active=false;
content.addEventListener("pointerdown",e=>{
if(content.scrollTop>0) return;
startY=e.clientY;
pulling=true;
active=false;
});
content.addEventListener("pointermove",e=>{
if(!pulling) return;
if(content.scrollTop>0){pulling=false;return;}
const dy=e.clientY-startY;
if(dy<=0) return;
active=true;
if(e.cancelable) e.preventDefault();
const dist=Math.min(dy*0.5,MAX);
indicator.style.transition="none";
indicator.style.marginTop=(dist-MAX)+"px";
const ready=dist>=THRESHOLD-2;
icon.textContent=ready?"🔄":"⬇️";
icon.classList.remove("spinning");
label.textContent=ready?"Отпустите для синхронизации":"Потяните для синхронизации";
},{passive:false});
function endPull(){
if(!pulling) return;
pulling=false;
if(!active) return;
active=false;
const rawMargin=parseFloat(indicator.style.marginTop);
const currentMargin=Number.isNaN(rawMargin)?(-MAX):rawMargin;
const dist=currentMargin+MAX;
if(dist>=THRESHOLD-2){
indicator.style.transition="margin-top .2s ease";
indicator.style.marginTop="0px";
icon.textContent="🔄";
icon.classList.add("spinning");
label.textContent="Синхронизация…";
vibrate(12);
syncNow({manual:true}).then(()=>{
setTimeout(()=>{
indicator.style.transition="margin-top .25s ease";
indicator.style.marginTop=(-MAX)+"px";
icon.classList.remove("spinning");
label.textContent="Потяните для синхронизации";
},450);
});
}else{
indicator.style.transition="margin-top .2s ease";
indicator.style.marginTop=(-MAX)+"px";
}
}
content.addEventListener("pointerup",endPull);
content.addEventListener("pointerleave",endPull);
content.addEventListener("pointercancel",endPull);
})();

// ---------- обновить приложение: удержание 2 сек с анимацией ----------
function attachHoldToUpdate(btnId,holdMs){
const btn=document.getElementById(btnId);
if(!btn) return;
const fill=btn.querySelector(".historyClearFill");
const labelEl=btn.querySelector(".historyClearLabelText");
const restLabel=labelEl.textContent;
let holdTimer=null,startTs=0,rafId=null;
function tick(){
if(!btn.classList.contains("holding")) return;
const elapsed=Date.now()-startTs;
const remain=Math.max(0,Math.ceil((holdMs-elapsed)/1000));
labelEl.textContent=`Держите… ${remain} с`;
rafId=requestAnimationFrame(tick);
}
function startHold(){
btn.classList.add("holding");
startTs=Date.now();
fill.style.transition="none";
fill.style.width="0%";
void fill.offsetWidth;
fill.style.transition=`width ${holdMs}ms linear`;
requestAnimationFrame(()=>{fill.style.width="100%";});
vibrate(10);
tick();
holdTimer=setTimeout(finishHold,holdMs);
}
function resetVisual(){
btn.classList.remove("holding");
fill.style.transition="width .25s ease";
fill.style.width="0%";
labelEl.textContent=restLabel;
}
function cancelHold(){
if(!holdTimer) return;
clearTimeout(holdTimer);
holdTimer=null;
if(rafId){cancelAnimationFrame(rafId);rafId=null;}
resetVisual();
}
function finishHold(){
holdTimer=null;
if(rafId){cancelAnimationFrame(rafId);rafId=null;}
resetVisual();
vibrate([20,40,20,40,20]);
startAppUpdate();
}
btn.addEventListener("pointerdown",e=>{e.preventDefault();startHold();});
btn.addEventListener("pointerup",cancelHold);
btn.addEventListener("pointerleave",cancelHold);
btn.addEventListener("pointercancel",cancelHold);
}
attachHoldToUpdate("updateAppBtn",2000);

// ---------- маленькая кнопка "обновить" рядом с крестиком в окне контактов ----------
function attachHoldToUpdateRing(btnId,holdMs){
const btn=document.getElementById(btnId);
if(!btn) return;
const ring=btn.querySelector(".updateBtnRingFg");
const icon=btn.querySelector(".updateBtnIcon");
let holdTimer=null;
function startHold(){
btn.classList.add("holding");
ring.style.transition="none";
ring.style.strokeDashoffset="75.4";
void ring.getBoundingClientRect();
ring.style.transition=`stroke-dashoffset ${holdMs}ms linear`;
requestAnimationFrame(()=>{ring.style.strokeDashoffset="0";});
vibrate(10);
holdTimer=setTimeout(finishHold,holdMs);
}
function resetVisual(){
btn.classList.remove("holding");
ring.style.transition="stroke-dashoffset .25s ease";
ring.style.strokeDashoffset="75.4";
}
function cancelHold(){
if(!holdTimer) return;
clearTimeout(holdTimer);
holdTimer=null;
resetVisual();
}
function finishHold(){
holdTimer=null;
resetVisual();
icon.classList.add("spinning");
vibrate([20,40,20,40,20]);
startAppUpdate();
}
btn.addEventListener("pointerdown",e=>{e.preventDefault();startHold();});
btn.addEventListener("pointerup",cancelHold);
btn.addEventListener("pointerleave",cancelHold);
btn.addEventListener("pointercancel",cancelHold);
}
attachHoldToUpdateRing("updateAppQuickBtn",2000);
async function startAppUpdate(){
document.getElementById("settingsModal").classList.remove("open");
document.getElementById("contactsModal").classList.remove("open");
document.getElementById("accountModal").classList.remove("open");
document.getElementById("updateOverlay").classList.add("open");
playBeep(520,90,0.12);
try{
if("serviceWorker" in navigator && navigator.serviceWorker.getRegistrations){
const regs=await navigator.serviceWorker.getRegistrations();
for(const r of regs){await r.update().catch(()=>{});}
}
if(window.caches && caches.keys){
const keys=await caches.keys();
await Promise.all(keys.map(k=>caches.delete(k)));
}
}catch(e){}
setTimeout(()=>{
playSyncSound(true);
location.reload();
},1600);
}

if("serviceWorker" in navigator){
window.addEventListener("load",()=>{
navigator.serviceWorker.register("service-worker.js").then(reg=>{
// сразу проверяем, нет ли новой версии — не ждём, пока браузер сам решит проверить
try{reg.update();}catch(e){}
// и повторяем проверку каждый раз, когда приложение возвращается на передний план
// (человек открыл телефон и вернулся в приложение из фона) — так обновления
// приходят сами, без необходимости держать кнопку "обновить" 2 секунды вручную
document.addEventListener("visibilitychange",()=>{
if(!document.hidden){try{reg.update();}catch(e){}}
});
}).catch(err=>console.log("SW error:",err));
// когда новый service worker берёт управление страницей — значит вышла новая версия
// приложения; аккуратно перезагружаем один раз, чтобы сразу подхватить свежий код.
// первое "controllerchange" на совсем новой установке — это не обновление, а обычный
// первый запуск, поэтому его пропускаем и не перезагружаем страницу зря
let hadControllerBefore=!!navigator.serviceWorker.controller,swRefreshing=false;
navigator.serviceWorker.addEventListener("controllerchange",()=>{
if(swRefreshing) return;
if(!hadControllerBefore){hadControllerBefore=true;return;}
swRefreshing=true;
location.reload();
});
// пока приложение открыто на экране, браузер обычно НЕ показывает системное push-уведомление
// поверх активной вкладки — поэтому service worker дублирует сигнал сюда: проигрываем звук,
// вибрируем и добавляем запись в колокольчик уведомлений, чтобы событие не потерялось
navigator.serviceWorker.addEventListener("message",(e)=>{
if(!e.data||e.data.type!=="xcar-push") return;
playBeep(740,90,0.16);
setTimeout(()=>playBeep(980,160,0.16),110);
vibrate([200,90,200,90,200]);
if(typeof addAppNotification==="function"){
addAppNotification({type:"push",text:e.data.body||e.data.title||"Событие на другом устройстве"});
}
});
});
}

let deferredPrompt;
const installBtn=document.getElementById("installBtn");
window.addEventListener("beforeinstallprompt",(e)=>{
e.preventDefault();
deferredPrompt=e;
installBtn.style.display="block";
});
installBtn.addEventListener("click",async()=>{
if(!deferredPrompt) return;
installBtn.style.display="none";
deferredPrompt.prompt();
await deferredPrompt.userChoice;
deferredPrompt=null;
});
window.addEventListener("appinstalled",()=>{
installBtn.style.display="none";
});

(function(){
const isIos=/iphone|ipad|ipod/i.test(navigator.userAgent);
const isInStandalone=("standalone" in navigator)&&navigator.standalone;
if(isIos && !isInStandalone){
document.getElementById("iosHint").style.display="block";
}
})();

// ==================== ПОДПИСКА ====================
// ⚠️ ИДРИС: замените реквизиты ниже на свои настоящие — они показываются
// клиентам в окне подписки вместе с QR-кодом для оплаты переводом.
const SUBSCRIPTION_PRICE_TEXT="500 ₽ / месяц";
const SUBSCRIPTION_BANK="Сбербанк";
const SUBSCRIPTION_CARD_NUMBER="0000 0000 0000 0000";
const SUBSCRIPTION_RECIPIENT="Бечиев Идрис Хож-Муратович";
const SUBSCRIPTION_PHONE="+7 928 739-00-92";

function getSubscriptionDaysLeft(){
return Math.max(0,Math.ceil(((settings.subscriptionUntil||0)-Date.now())/86400000));
}
function isSubscriptionExpired(){
return getSubscriptionDaysLeft()<=0;
}
function subscriptionBlocksNewCar(){
return isSubscriptionExpired() && cars.length>=1;
}
function renderSubscriptionUI(){
const days=getSubscriptionDaysLeft();
const expired=isSubscriptionExpired();
const dayWord=(n)=>{
const n10=n%10,n100=n%100;
if(n100>=11&&n100<=14) return "дней";
if(n10===1) return "день";
if(n10>=2&&n10<=4) return "дня";
return "дней";
};
const daysText=expired?"Подписка истекла":`Осталось ${days} ${dayWord(days)}`;
const card=document.getElementById("subscriptionCard");
const cardDays=document.getElementById("subscriptionCardDays");
const cardHint=document.getElementById("subscriptionCardHint");
const folderHint=document.getElementById("subscriptionFolderHint");
if(card) card.classList.toggle("expired",expired);
if(cardDays) cardDays.textContent=daysText;
if(cardHint) cardHint.textContent=expired?"Доступна только 1 машина — нажмите, чтобы продлить":"Нажмите, чтобы продлить подписку";
if(folderHint) folderHint.textContent=daysText;
}
function renderSubQr(){
const canvas=document.getElementById("subQrCanvas");
if(!canvas) return;
const ctx=canvas.getContext("2d");
ctx.clearRect(0,0,canvas.width,canvas.height);
if(typeof qrcode==="undefined"){
ctx.fillStyle="#8a93a3";
ctx.font="11px system-ui";
ctx.textAlign="center";
ctx.fillText("QR недоступен офлайн",canvas.width/2,canvas.height/2);
return;
}
try{
const text=`Оплата подписки XCAR\n${SUBSCRIPTION_PRICE_TEXT}\nБанк: ${SUBSCRIPTION_BANK}\nКарта: ${SUBSCRIPTION_CARD_NUMBER}\nПолучатель: ${SUBSCRIPTION_RECIPIENT}\nТел: ${SUBSCRIPTION_PHONE}`;
const qr=qrcode(0,"M");
qr.addData(text);
qr.make();
const count=qr.getModuleCount();
const size=canvas.width;
const cell=size/count;
ctx.fillStyle="#fff";
ctx.fillRect(0,0,size,size);
ctx.fillStyle="#001f5b";
for(let r=0;r<count;r++){
for(let c=0;c<count;c++){
if(qr.isDark(r,c)) ctx.fillRect(c*cell,r*cell,cell+0.5,cell+0.5);
}
}
}catch(e){}
}
function openSubscriptionModal(){
document.getElementById("subscriptionModalSub").textContent=isSubscriptionExpired()?"Подписка истекла — доступна только 1 машина":`Осталось ${getSubscriptionDaysLeft()} дней`;
document.getElementById("subRequisites").innerHTML=
`<b>Стоимость:</b> ${escapeHtml(SUBSCRIPTION_PRICE_TEXT)}<br>`+
`<b>Банк:</b> ${escapeHtml(SUBSCRIPTION_BANK)}<br>`+
`<b>Номер карты:</b> ${escapeHtml(SUBSCRIPTION_CARD_NUMBER)}<br>`+
`<b>Получатель:</b> ${escapeHtml(SUBSCRIPTION_RECIPIENT)}<br>`+
`<b>Телефон:</b> ${escapeHtml(SUBSCRIPTION_PHONE)}`;
document.getElementById("subClientName").value="";
document.getElementById("subClientPhone").value=settings.account.phone||"";
document.getElementById("subRequestHint").textContent="";
document.getElementById("subscriptionModal").classList.add("open");
renderSubQr();
}
document.getElementById("subscriptionCard").addEventListener("click",()=>{
vibrate(10);
openSubscriptionModal();
});
document.getElementById("subscriptionCloseBtn").addEventListener("click",()=>{
document.getElementById("subscriptionModal").classList.remove("open");
});
document.getElementById("subscriptionModal").addEventListener("click",(e)=>{
if(e.target.id==="subscriptionModal") e.target.classList.remove("open");
});
document.getElementById("subSendRequestBtn").addEventListener("click",async()=>{
const name=document.getElementById("subClientName").value.trim();
const phone=document.getElementById("subClientPhone").value.trim();
const hint=document.getElementById("subRequestHint");
if(!name||!phone){hint.textContent="Укажите Ф.И.О и номер телефона";hint.style.color="#c62828";vibrate(20);return;}
const base=(settings.account.serverUrl||"").trim().replace(/\/+$/,"");
if(!base){
hint.innerHTML=`Сервер не настроен — свяжитесь с Идрисом напрямую: <a href="tel:${SUBSCRIPTION_PHONE.replace(/\s+/g,"")}">${escapeHtml(SUBSCRIPTION_PHONE)}</a>`;
hint.style.color="#5a6270";
return;
}
hint.textContent="Отправка заявки…";
hint.style.color="#5a6270";
try{
const resp=await fetch(base+"/api/subscription/request",{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({username:settings.account.username||"",name,phone})
});
if(!resp.ok) throw new Error("HTTP "+resp.status);
hint.textContent="Заявка отправлена ✓ Идрис проверит оплату и подключит подписку";
hint.style.color="#0a9a4a";
flashSuccess(document.getElementById("subSendRequestBtn"));
vibrate([15,25,15]);
}catch(e){
hint.textContent="Не удалось отправить заявку — проверьте соединение";
hint.style.color="#c62828";
vibrate([40,40,40]);
}
});

// ==================== ЧЁРНЫЙ СПИСОК ====================
async function refreshBlacklistMeta(){
const base=(settings.account.serverUrl||"").trim().replace(/\/+$/,"");
const hintEl=document.getElementById("blacklistLastUpdatedHint");
if(!base){if(hintEl) hintEl.textContent="сервер не настроен";return;}
try{
const resp=await fetch(base+"/api/blacklist/meta",{cache:"no-store"});
if(!resp.ok) throw new Error("HTTP "+resp.status);
const data=await resp.json();
const text=data.lastUpdatedAt?("обновлено "+new Date(data.lastUpdatedAt).toLocaleDateString("ru-RU")):"пока пусто";
if(hintEl) hintEl.textContent=text;
document.getElementById("blacklistSub").textContent=data.lastUpdatedAt?("Обновлено: "+new Date(data.lastUpdatedAt).toLocaleString("ru-RU")):"Обновлено: —";
}catch(e){
if(hintEl) hintEl.textContent="недоступно";
}
}
function openBlacklistPanel(){
contactsModal.classList.remove("open");
const input=document.getElementById("blacklistSearchInput");
const results=document.getElementById("blacklistResults");
if(input) input.value="";
if(results) results.innerHTML="";
document.getElementById("blacklistModal").classList.add("open");
refreshBlacklistMeta();
vibrate(8);
}
const blacklistOpenBtn=document.getElementById("blacklistOpenBtn");
if(blacklistOpenBtn) blacklistOpenBtn.addEventListener("click",openBlacklistPanel);
document.getElementById("blacklistCloseBtn").addEventListener("click",()=>{
document.getElementById("blacklistModal").classList.remove("open");
});
document.getElementById("blacklistModal").addEventListener("click",(e)=>{
if(e.target.id==="blacklistModal") e.target.classList.remove("open");
});
async function runBlacklistSearch(){
const q=document.getElementById("blacklistSearchInput").value.trim();
const results=document.getElementById("blacklistResults");
if(q.length<2){results.innerHTML=`<div class="settingsBackupHint" style="color:#c62828;">Введите минимум 2 символа</div>`;return;}
const base=(settings.account.serverUrl||"").trim().replace(/\/+$/,"");
if(!base){results.innerHTML=`<div class="settingsBackupHint" style="color:#c62828;">Укажите сервер в Настройках → Серверы, чтобы проверять чёрный список</div>`;return;}
results.innerHTML=`<div class="settingsBackupHint">Проверка…</div>`;
try{
const resp=await fetch(base+"/api/blacklist/search",{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({query:q})
});
if(!resp.ok) throw new Error("HTTP "+resp.status);
const data=await resp.json();
if(!data.results||!data.results.length){
results.innerHTML=`<div class="blacklistClean">✅ Совпадений нет — клиент не в чёрном списке</div>`;
vibrate(12);
return;
}
results.innerHTML=data.results.map(r=>
`<div class="blacklistResultItem"><b>⚠️ Найдено в «${escapeHtml(r.filename)}»</b><br>${escapeHtml(r.snippet)}</div>`
).join("");
vibrate([20,30,20]);
}catch(e){
results.innerHTML=`<div class="settingsBackupHint" style="color:#c62828;">Не удалось выполнить проверку — нет соединения с сервером</div>`;
}
}
document.getElementById("blacklistSearchBtn").addEventListener("click",runBlacklistSearch);
document.getElementById("blacklistSearchInput").addEventListener("keydown",e=>{
if(e.key==="Enter") runBlacklistSearch();
});

// ---------- применяем тему и видимость стрелок при запуске ----------
applyNavArrowsVisibility();
renderSubscriptionUI();


/* ===== XCAR INTERACTION MOTION ===== */
(function(){
  const reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function ripple(e){
    if(reduce) return;
    const el=e.currentTarget;
    if(!el || el.disabled) return;
    const r=document.createElement('span'); r.className='ripple-wave';
    const rect=el.getBoundingClientRect();
    const x=(e.clientX||rect.left+rect.width/2)-rect.left-16;
    const y=(e.clientY||rect.top+rect.height/2)-rect.top-16;
    r.style.left=x+'px'; r.style.top=y+'px';
    el.appendChild(r); setTimeout(()=>r.remove(),600);
  }
  document.addEventListener('pointerdown',e=>{
    const el=e.target.closest('button,.navBtn,.modalClose');
    if(el) ripple({currentTarget:el,clientX:e.clientX,clientY:e.clientY});
  },{passive:true});

  // Короткая плавная подсветка после успешного действия.
  window.xcarAnimateSuccess=function(el){
    if(!el||reduce) return;
    el.animate([{transform:'scale(1)'},{transform:'scale(1.025)'},{transform:'scale(1)'}],{duration:360,easing:'cubic-bezier(.16,1,.3,1)'});
  };

  // Не наблюдаем и не анимируем все добавления в document.body: при перерисовке
  // больших списков это создавало лишние layout/paint-циклы и микрофризы.
  const obs=new MutationObserver(muts=>{
    if(reduce) return;
    for(const m of muts) for(const n of m.addedNodes){
      if(n.nodeType!==1 || !n.hasAttribute('data-xcar-animate')) continue;
      n.animate([{opacity:0,transform:'translateY(6px)'},{opacity:1,transform:'translateY(0)'}],{duration:220,easing:'cubic-bezier(.16,1,.3,1)',fill:'both'});
    }
  });
  obs.observe(document.body,{childList:true,subtree:true});

  // Плавный скролл по клику на внутренние якоря/элементы с data-scroll-to.
  document.addEventListener('click',e=>{
    const el=e.target.closest('[data-scroll-to]'); if(!el) return;
    const target=document.querySelector(el.getAttribute('data-scroll-to'));
    if(target){e.preventDefault();target.scrollIntoView({behavior:reduce?'auto':'smooth',block:'center'});}
  });
})();

</script>
</body>
</html>

