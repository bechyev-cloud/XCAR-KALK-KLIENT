document.getElementById("cardViewBtn").addEventListener("click",()=>{
const current=settings.fleetViewStyle||"current";
document.querySelectorAll(".cardViewMenuBtn").forEach(b=>b.classList.toggle("active",b.dataset.fleetview===current));
document.getElementById("cardViewMenu").classList.add("open");
});
document.getElementById("cardViewMenu").addEventListener("click",e=>{
if(e.target.id==="cardViewMenu"){e.currentTarget.classList.remove("open");return;}
const b=e.target.closest(".cardViewMenuBtn[data-fleetview]");
if(!b)return;
const view=b.dataset.fleetview;
settings.fleetViewStyle=view;
