<script>
function num(v){return parseFloat((v||"").toString().replace(/\s/g,''))||0;}
function space(n){return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g," ");}

(function setDefaultDateTime(){
const now=new Date();
const pad=n=>("0"+n).slice(-2);
const todayStr=now.getFullYear()+"-"+pad(now.getMonth()+1)+"-"+pad(now.getDate());
const timeStr=pad(now.getHours())+":"+pad(now.getMinutes());
document.getElementById("startDate").value=todayStr;
document.getElementById("startTime").value=timeStr;
document.getElementById("endTime").value=timeStr;
document.getElementById("endDate").value="";
})();

["pricePerDay","pricePerHour","oldDebt","paid"].forEach(id=>{
document.getElementById(id).addEventListener("input",e=>{
let val=e.target.value.replace(/\D/g,'');
e.target.value=space(val);
});
});

// ---------- список автомобилей (выбор + управление) ----------
const CAR_STORAGE_KEY="xcarCars";
const DEFAULT_CARS=[
{name:"Lada Vesta",price:2500,rented:false,rentedSince:null,rentedUntil:null,rentedPaid:0,reserved:false,logo:""},
{name:"Hyundai Solaris",price:3000,rented:false,rentedSince:null,rentedUntil:null,rentedPaid:0,reserved:false,logo:""},
{name:"Kia Rio",price:3200,rented:false,rentedSince:null,rentedUntil:null,rentedPaid:0,reserved:false,logo:""},
{name:"Toyota Camry",price:5000,rented:false,rentedSince:null,rentedUntil:null,rentedPaid:0,reserved:false,logo:""},
{name:"Ford Focus 3",price:6000,rented:false,rentedSince:null,rentedUntil:null,rentedPaid:0,reserved:false,logo:""}
];
function loadCars(){
try{
const raw=localStorage.getItem(CAR_STORAGE_KEY);
if(raw){
const parsed=JSON.parse(raw);
if(Array.isArray(parsed)&&parsed.length){
parsed.forEach(c=>{
if(typeof c.rented!=="boolean") c.rented=false;
if(typeof c.rentedSince!=="string") c.rentedSince=null;
if(typeof c.rentedUntil!=="string") c.rentedUntil=null;
if(typeof c.rentedPaid!=="number") c.rentedPaid=0;
if(typeof c.reserved!=="boolean") c.reserved=false;
if(typeof c.logo!=="string") c.logo="";
if(c.rented&&!c.rentedSince) c.rentedSince=new Date().toISOString();
});
return parsed;
}
}
}catch(e){}
return DEFAULT_CARS.slice();
}
function saveCars(){
try{localStorage.setItem(CAR_STORAGE_KEY, JSON.stringify(cars));}catch(e){}
markDirty();
}
let cars=loadCars();
let selectedCarIdx=null;

// ---------- настройки приложения (способ начисления активной аренды) ----------
const SETTINGS_KEY="xcarSettings";
const SUBSCRIPTION_DEFAULT_DAYS=365;
// сервер по умолчанию — уже подключён у каждого нового пользователя приложения,
// добавлять вручную в Настройках не нужно
const DEFAULT_SERVER_URL="https://xcar-kalk-klient.onrender.com";
const DEFAULT_SERVER_ID="default-render";
function defaultSettings(){
return {billingMode:"prepay",account:{serverUrl:DEFAULT_SERVER_URL,username:"",password:"",email:"",phone:"",connected:false},serverProfiles:[{id:DEFAULT_SERVER_ID,name:"Render (XCAR)",url:DEFAULT_SERVER_URL}],activeServerProfileId:DEFAULT_SERVER_ID,pushEnabled:false,pushEndpoint:"",theme:"light",showNavArrows:true,subscriptionUntil:Date.now()+SUBSCRIPTION_DEFAULT_DAYS*86400000,autoSyncEnabled:true,autoSyncIntervalSec:30,fleetViewStyle:"current",uiStyle:"standard"};
}
function loadSettings(){
try{
const raw=localStorage.getItem(SETTINGS_KEY);
if(!raw) return defaultSettings(); // самый первый запуск приложения — сразу подключаем сервер по умолчанию
const parsed=JSON.parse(raw);
const acc=parsed.account&&typeof parsed.account==="object"?parsed.account:{};
const profiles=Array.isArray(parsed.serverProfiles)?parsed.serverProfiles.filter(p=>p&&typeof p==="object"&&typeof p.id==="string"&&typeof p.url==="string").map(p=>({id:p.id,name:typeof p.name==="string"?p.name:"Сервер",url:p.url,ping:null})):[];
return {
billingMode:parsed.billingMode==="persecond"?"persecond":"prepay",
account:{
serverUrl:typeof acc.serverUrl==="string"?acc.serverUrl:"",
username:typeof acc.username==="string"?acc.username:"",
password:typeof acc.password==="string"?acc.password:"",
email:typeof acc.email==="string"?acc.email:"",
phone:typeof acc.phone==="string"?acc.phone:"",
connected:!!acc.connected
},
serverProfiles:profiles,
activeServerProfileId:typeof parsed.activeServerProfileId==="string"?parsed.activeServerProfileId:null,
pushEnabled:!!parsed.pushEnabled,
pushEndpoint:typeof parsed.pushEndpoint==="string"?parsed.pushEndpoint:"",
theme:parsed.theme==="dark"?"dark":"light",
showNavArrows:parsed.showNavArrows!==false,
subscriptionUntil:typeof parsed.subscriptionUntil==="number"&&parsed.subscriptionUntil>0?parsed.subscriptionUntil:(Date.now()+SUBSCRIPTION_DEFAULT_DAYS*86400000),
autoSyncEnabled:parsed.autoSyncEnabled!==false,
autoSyncIntervalSec:Math.min(59,Math.max(1,parseInt(parsed.autoSyncIntervalSec,10)||30)),
fleetViewStyle:(parsed.fleetViewStyle==="tile"?"grid":parsed.fleetViewStyle==="compact"?"list":parsed.fleetViewStyle==="list"?"current":["grid","list","current","premium"].includes(parsed.fleetViewStyle)?parsed.fleetViewStyle:"current"),
uiStyle:parsed.uiStyle==="new"?"new":"standard"
};
}catch(e){return defaultSettings();}
}
function saveSettings(){
try{localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));}catch(e){}
}
let settings=loadSettings();
function applyTheme(){
document.documentElement.setAttribute("data-theme",settings.theme==="dark"?"dark":"light");
const meta=document.querySelector('meta[name="theme-color"]');
if(meta) meta.setAttribute("content",settings.theme==="dark"?"#070b13":"#0b1f33");
}
function applyUIStyle(){
document.documentElement.setAttribute("data-ui-style",settings.uiStyle==="new"?"new":"standard");
}
applyTheme();
applyUIStyle();
function applyNavArrowsVisibility(){
const v=settings.showNavArrows!==false;
const l=document.getElementById("navLeftBtn");
const r=document.getElementById("navRightBtn");
if(l) l.style.display=v?"":"none";
if(r) r.style.display=v?"":"none";
}
function markDirty(){
try{localStorage.setItem("xcarLocalUpdatedAt", String(Date.now()));}catch(e){}
}
function getLocalUpdatedAt(){
try{return parseInt(localStorage.getItem("xcarLocalUpdatedAt")||"0",10)||0;}catch(e){return 0;}
}

function updateCarPickerLabel(){
const label=document.getElementById("carPickerLabel");
const car=(selectedCarIdx!==null)?cars[selectedCarIdx]:null;
if(!car){
label.className="placeholder";
label.textContent="— Выберите автомобиль —";
}else{
label.className="carPickerChosen";
label.innerHTML=`<span class="carEmoji">🚗</span>`+
`<span class="carPickerText">`+
`<div class="carPickerName">${car.name}</div>`+
`<div class="carPickerPrice">${space(car.price)} ₽/сутки</div>`+
`</span>`;
}
}

function renderCarPickerList(){
const wrap=document.getElementById("carPickerList");
wrap.innerHTML="";
if(!cars.length){
wrap.innerHTML=`<div class="carEmptyState"><div class="historyEmptyIcon">🚘</div>Список пуст.<br>Добавьте автомобиль в меню ›</div>`;
return;
}
cars.forEach((c,i)=>{
const item=document.createElement("div");
item.className="carItem"+(i===selectedCarIdx?" selected":"");
item.innerHTML=`<div class="carItemEmoji">${c.logo?`<img src="${c.logo}" style="width:34px;height:34px;object-fit:contain;border-radius:8px;">`:`🚗`}</div>`+
`<div class="carItemInfo">`+
`<div class="carItemName">${c.name}</div>`+
`<div class="carItemPrice">${space(c.price)} ₽/сутки</div>`+
`</div>`;
item.addEventListener("click",()=>{
selectedCarIdx=i;
pricePerDay.value=space(c.price);
updateCarPickerLabel();
document.getElementById("carPickerModal").classList.remove("open");
});
wrap.appendChild(item);
});
}

function updatePage2Subtitle(){
const el=document.getElementById("page2Subtitle");
if(!el) return;
const rentedCount=cars.filter(c=>c.rented).length;
el.textContent=`Машин: ${cars.length} · В аренде: ${rentedCount}`;
}

function carPhotoAvatarHtml(c,i){
return `<div class="carPhotoAvatar">${c.logo?`<img src="${c.logo}" alt="">`:(c.photo?`<img src="${c.photo}" alt="">`:`<span class="carPhotoEmoji">🚗</span>`)}<button type="button" class="carPhotoBtn" data-idx="${i}" title="Добавить фото">📷</button></div>`;
}
function renderCarManageList(){
const wrap=document.getElementById("carManageList");
wrap.innerHTML="";
updatePage2Subtitle();
const view=settings.fleetViewStyle||"current";
const style=view==="grid"?"tile":view==="list"?"compact":view==="premium"?"premium":"list";
wrap.classList.toggle("viewTile",view==="grid");
wrap.classList.toggle("viewPremium",view==="premium");
document.querySelectorAll(".fleetViewOpt").forEach(b=>b.classList.toggle("active",b.dataset.view===view));
if(!cars.length){
wrap.innerHTML=`<div class="carEmptyState"><div class="historyEmptyIcon">🚘</div>Список пуст.<br>Добавьте первый автомобиль ниже</div>`;
return;
}
cars.forEach((c,i)=>{
const card=document.createElement("div");
const safeName=c.name.replace(/"/g,"&quot;");
const sinceText=(c.rented&&c.rentedSince)?`<div class="carRentSince">🕓 с ${fmtDateTime(new Date(c.rentedSince))}`+
(c.rentedUntil?` · 🏁 до ${fmtDateTime(new Date(c.rentedUntil))}`:"")+
(c.rentedPaid?` · внесено ${space(c.rentedPaid)} ₽`:"")+
`</div>`:"";
const rentSwitchHtml=`<label class="rentSwitch"><input type="checkbox" class="carRentCheck" ${c.rented?"checked":""}>`+
`<span class="rentSwitchLabel">Оформить</span>`+
`<span class="rentSwitchTrack"><span class="rentSwitchThumb"></span></span>`+
`</label>`;
if(style==="tile"){
card.className="carManageCard styleTile";
card.innerHTML=carPhotoAvatarHtml(c,i)+
`<input class="carEditName carTileName" value="${safeName}">`+
`<input class="carEditPrice carTilePrice" inputmode="numeric" value="${space(c.price)}">`+
`<button type="button" class="carDeleteBtn" title="Удалить">🗑️</button>`+
rentSwitchHtml+
sinceText;
}else if(style==="compact"){
card.className="carManageCard styleCompact";
card.innerHTML=carPhotoAvatarHtml(c,i)+
`<div class="carCompactInfo">`+
`<input class="carEditName carCompactName" value="${safeName}">`+
`<input class="carEditPrice carCompactPrice" inputmode="numeric" value="${space(c.price)}">`+
`</div>`+
rentSwitchHtml+
`<button type="button" class="carDeleteBtn" title="Удалить">🗑️</button>`+
sinceText;
}else if(style==="premium"){
card.className="carManageCard stylePremium";
card.innerHTML=`<div class="premiumVisual">${carPhotoAvatarHtml(c,i)}<div class="premiumShade"></div><div class="premiumTopBadge">${c.rented?"В АРЕНДЕ":c.reserved?"БРОНЬ":"СВОБОДНО"}</div><button type="button" class="carDeleteBtn" title="Удалить">🗑️</button></div>`+
`<div class="premiumBody"><div class="premiumTitleRow"><input class="carEditName carPremiumName" value="${safeName}"><span class="premiumPrice"><input class="carEditPrice carPremiumPrice" inputmode="numeric" value="${space(c.price)}"> <small>₽/сутки</small></span></div>`+
`<div class="premiumMeta"><span>${c.rented?"🔑 Машина сейчас в аренде":"● Машина свободна"}</span>${c.rented&&c.rentedSince?`<span>🕓 ${fmtDateTime(new Date(c.rentedSince))}</span>`:""}</div>`+
rentSwitchHtml+sinceText+`</div>`;
}else{
card.className="carManageCard styleList";
card.innerHTML=`<div class="carSettingsRow">`+
carPhotoAvatarHtml(c,i)+
`<div class="carNameWrap"><div class="carNameFill"></div><input class="carEditName" value="${safeName}"></div>`+
`<input class="carEditPrice" inputmode="numeric" value="${space(c.price)}">`+
`<button type="button" class="carDeleteBtn" title="Удалить">🗑️</button>`+
`</div>`+
rentSwitchHtml+
sinceText;
}
const nameInput=card.querySelector(".carEditName");
const priceInput=card.querySelector(".carEditPrice");
const rentCheck=card.querySelector(".carRentCheck");
nameInput.addEventListener("input",()=>{
cars[i].name=nameInput.value;
saveCars();
updateCarPickerLabel();
});
priceInput.addEventListener("input",e=>{
let v=e.target.value.replace(/\D/g,'');
e.target.value=space(v);
cars[i].price=num(priceInput.value);
saveCars();
if(i===selectedCarIdx) pricePerDay.value=space(cars[i].price);
updateCarPickerLabel();
});
rentCheck.addEventListener("change",()=>{
if(rentCheck.checked){
openRentModal(i);
}else if(c.rented){
openCompleteRentModal(i);
}else{
// Если автомобиль свободен/в броне, выключение тумблера ничего не меняет.
renderCarManageList();
}
});
card.querySelector(".carPhotoBtn").addEventListener("click",()=>{
carPhotoTargetIdx=i;
const fileInput=document.getElementById("carPhotoFileInput");
if(fileInput) fileInput.click();
});
card.querySelector(".carDeleteBtn").addEventListener("click",()=>{
showConfirm({
title:"Удалить автомобиль?",
message:`«${c.name}» будет удалён из автопарка. Это действие нельзя отменить.`,
confirmText:"Удалить",
onConfirm:()=>{
cars.splice(i,1);
if(selectedCarIdx===i) selectedCarIdx=null;
else if(selectedCarIdx!==null&&selectedCarIdx>i) selectedCarIdx--;
saveCars();
renderCarManageList();
renderCarPickerList();
renderRentedList();
updateCarPickerLabel();
}
});
});
const statusRow=document.createElement("div");
statusRow.className="carStatusRow";
const status=document.createElement("span");
const statusKey=c.rented?"rented":c.reserved?"reserved":"free";
status.className="carStatusBadge "+(statusKey==="rented"?"carStatusRented":statusKey==="reserved"?"carStatusReserved":"carStatusFree");
status.innerHTML=`<span class="carStatusDot"></span>${statusKey==="rented"?"В АРЕНДЕ":statusKey==="reserved"?"БРОН":"СВОБОДНО"}`;
statusRow.appendChild(status);
card.appendChild(statusRow);
const hint=document.createElement("div");hint.className="carEditLongHint";hint.textContent="Удерживайте карточку 1,5 сек — изменить";card.appendChild(hint);
attachCarHold(card,i);
card.addEventListener("click",e=>{
if(e.target.closest("button,input,.carPhotoBtn")) return;
if(card.__longPressed){card.__longPressed=false;return;}
});
wrap.appendChild(card);
});
updateFleetRentProgress();
}

// ---------- расширенное редактирование автомобиля: удержание 3 сек ----------
let carEditIdx=null, carLogoTargetIdx=null;
const carEditModal=document.getElementById("carEditModal");
function openCarEditModal(i){
carEditIdx=i; const c=cars[i]; if(!c) return;
document.getElementById("carEditModalName").value=c.name||"";
document.getElementById("carEditModalPrice").value=space(c.price||0);
const p=document.getElementById("carLogoPreview"); p.innerHTML=c.logo?`<img src="${c.logo}" alt="">`:`🚗`;
carEditModal.classList.add("open"); vibrate(15);
}
function closeCarEditModal(){carEditModal.classList.remove("open");carEditIdx=null;}
document.getElementById("carEditCloseBtn").addEventListener("click",closeCarEditModal);
document.getElementById("carEditCancelBtn").addEventListener("click",closeCarEditModal);
carEditModal.addEventListener("click",e=>{if(e.target.id==="carEditModal") closeCarEditModal();});
document.getElementById("carEditModalPrice").addEventListener("input",e=>{e.target.value=space(e.target.value.replace(/\D/g,''));});
document.getElementById("carEditSaveBtn").addEventListener("click",()=>{
if(carEditIdx===null||!cars[carEditIdx]) return; const c=cars[carEditIdx];
c.name=document.getElementById("carEditModalName").value.trim()||"Новый автомобиль";
c.price=num(document.getElementById("carEditModalPrice").value);
saveCars(); renderCarManageList(); renderRentedList(); renderCarPickerList(); updateCarPickerLabel();
flashSuccess(document.getElementById("carEditSaveBtn")); closeCarEditModal();
});
document.getElementById("carLogoBtn").addEventListener("click",()=>document.getElementById("carLogoFileInput").click());
document.getElementById("carLogoFileInput").addEventListener("change",async e=>{
const file=e.target.files&&e.target.files[0]; e.target.value=""; if(!file||carEditIdx===null) return;
try{const data=await resizeImageFile(file,320,.78); if(cars[carEditIdx]){cars[carEditIdx].logo=data;document.getElementById("carLogoPreview").innerHTML=`<img src="${data}" alt="">`;saveCars();}}catch(err){}
});
function attachCarHold(card,i){
  let timer=null,down=false,moved=false,startX=0,startY=0,opening=false;
  const HOLD_MS=1500, MOVE_LIMIT=12;
  const overlay=document.createElement("div");
  overlay.className="carHoldOverlay";
  overlay.innerHTML='<div class="carHoldOverlayFill"></div><div class="carHoldLabel">Открытие редактирования…</div>';
  card.appendChild(overlay);
  const fill=overlay.querySelector(".carHoldOverlayFill");
  const reset=()=>{
    down=false;
    if(timer){clearTimeout(timer);timer=null;}
    card.classList.remove("carHolding");
    if(fill){fill.style.animation="none"; void fill.offsetWidth; fill.style.animation="";}
  };
  const start=(e)=>{
    if(opening || e.button===2) return;
    down=true; moved=false; startX=e.clientX; startY=e.clientY;
    card.__longPressed=false;
    card.classList.add("carHolding");
    timer=setTimeout(()=>{
      if(!down||moved) return;
      opening=true;
      card.__longPressed=true;
      card.classList.remove("carHolding");
      card.classList.add("carHoldOpening");
      vibrate([12,25,12]);
      setTimeout(()=>{openCarEditModal(i); card.classList.remove("carHoldOpening"); opening=false;},120);
    },HOLD_MS);
  };
  const move=(e)=>{
    if(!down) return;
    if(Math.hypot(e.clientX-startX,e.clientY-startY)>MOVE_LIMIT){moved=true;reset();}
  };
  const end=()=>{if(!opening) reset();};
  card.addEventListener("pointerdown",start);
  card.addEventListener("pointermove",move);
  card.addEventListener("pointerup",end);
  card.addEventListener("pointercancel",end);
  card.addEventListener("pointerleave",end);
}

// ---------- фото машины: выбор файла, сжатие до разумного размера и сохранение в base64 ----------
let carPhotoTargetIdx=null;
function resizeImageFile(file,maxDim,quality){
return new Promise((resolve,reject)=>{
const reader=new FileReader();
reader.onload=e=>{
const img=new Image();
img.onload=()=>{
let w=img.width,h=img.height;
if(w>maxDim||h>maxDim){
if(w>h){h=Math.round(h*maxDim/w);w=maxDim;}
else{w=Math.round(w*maxDim/h);h=maxDim;}
}
const canvas=document.createElement("canvas");
canvas.width=w;canvas.height=h;
const ctx=canvas.getContext("2d");
ctx.drawImage(img,0,0,w,h);
try{resolve(canvas.toDataURL("image/jpeg",quality));}
catch(err){reject(err);}
};
img.onerror=reject;
img.src=e.target.result;
};
reader.onerror=reject;
reader.readAsDataURL(file);
});
}
document.getElementById("carPhotoFileInput").addEventListener("change",async(e)=>{
const file=e.target.files&&e.target.files[0];
e.target.value="";
if(!file||carPhotoTargetIdx===null) return;
const idx=carPhotoTargetIdx;
try{
const dataUrl=await resizeImageFile(file,480,0.72);
if(cars[idx]){
cars[idx].photo=dataUrl;
saveCars();
renderCarManageList();
renderRentedList();
renderCarPickerList();
vibrate(12);
}
}catch(err){
vibrate([40,40,40]);
}
});
// ---------- переключатель вида карточек автопарка (список / плитка / компакт) ----------
document.querySelectorAll(".fleetViewOpt").forEach(btn=>{
btn.addEventListener("click",()=>{
const view=btn.dataset.view;
settings.fleetViewStyle=view;
saveSettings();
document.querySelectorAll(".fleetViewOpt").forEach(b=>b.classList.toggle("active",b.dataset.view===view));
renderCarManageList();
vibrate(10);
});
});

// заливка имени машины красный→жёлтый→зелёный по прогрессу текущих суток аренды (обновляется
// без перерисовки всего списка, чтобы не сбивать фокус/курсор при вводе)
function dayProgressPct(c){
if(!c.rented||!c.rentedSince) return 0;
const start=new Date(c.rentedSince);
const now=new Date();
let elapsedMs=now-start;
if(!(elapsedMs>0)) elapsedMs=0;
const totalHours=elapsedMs/3600000;
const frac=totalHours-Math.floor(totalHours/24)*24;
return Math.min(100,Math.max(0,(frac/24)*100));
}
function updateFleetRentProgress(){
const wrap=document.getElementById("carManageList");
if(!wrap) return;
const cards=wrap.querySelectorAll(".carManageCard");
cards.forEach((card,i)=>{
const c=cars[i];
const fill=card.querySelector(".carNameFill");
if(!c||!fill) return;
if(c.rented&&c.rentedSince){
const pct=dayProgressPct(c);
fill.classList.add("active");
fill.style.clipPath=`inset(0 ${(100-pct).toFixed(2)}% 0 0)`;
}else{
fill.classList.remove("active");
fill.style.clipPath="inset(0 100% 0 0)";
}
});
}
setInterval(()=>{
  const drawer=document.getElementById('page2Drawer');
  if(drawer && drawer.classList.contains('open')) updateFleetRentProgress();
},2000);

function fmtDateTime(d){
const pad=n=>("0"+n).slice(-2);
return fmtDate(d)+" "+pad(d.getHours())+":"+pad(d.getMinutes());
}

// ---------- модалка оформления аренды ----------
let rentModalCarIdx=null;
const rentModal=document.getElementById("rentModal");
function openRentModal(i){
rentModalCarIdx=i;
const c=cars[i];
document.getElementById("rentModalCarName").textContent=c.name;
const now=new Date();
const pad=n=>("0"+n).slice(-2);
document.getElementById("rentStartDate").value=now.getFullYear()+"-"+pad(now.getMonth()+1)+"-"+pad(now.getDate());
document.getElementById("rentStartTime").value=pad(now.getHours())+":"+pad(now.getMinutes());
document.getElementById("rentEndDate").value="";
document.getElementById("rentEndTime").value="";
document.getElementById("rentPricePerDay").value=space(c.price);
document.getElementById("rentUpfrontPaid").value="";
document.getElementById("rentClientAlias").value=c.rentClientAlias||"";
const rb=document.getElementById("rentReserveBtn"); rb.classList.toggle("active",!!c.reserved); rb.textContent=c.reserved?"⭐ В броне":"⭐ Бронь";
rentModal.classList.add("open");
}
function closeRentModal(revert){
rentModal.classList.remove("open");
rentModalCarIdx=null;
if(revert) renderCarManageList();
}
["rentPricePerDay","rentUpfrontPaid"].forEach(id=>{
document.getElementById(id).addEventListener("input",e=>{
let v=e.target.value.replace(/\D/g,'');
e.target.value=space(v);
});
});
document.getElementById("rentReserveBtn").addEventListener("click",()=>{if(rentModalCarIdx===null)return; const c=cars[rentModalCarIdx]; c.reserved=!c.reserved; const b=document.getElementById("rentReserveBtn"); b.classList.toggle("active",c.reserved); b.textContent=c.reserved?"⭐ В броне":"⭐ Бронь"; saveCars(); renderCarManageList();});
document.getElementById("rentModalCloseBtn").addEventListener("click",()=>closeRentModal(true));
document.getElementById("rentCancelBtn").addEventListener("click",()=>closeRentModal(true));
rentModal.addEventListener("click",e=>{
if(e.target.id==="rentModal") closeRentModal(true);
});
document.getElementById("rentSaveBtn").addEventListener("click",()=>{
if(rentModalCarIdx===null) return;
const i=rentModalCarIdx;
const sd=document.getElementById("rentStartDate").value;
const st=document.getElementById("rentStartTime").value;
if(!sd){alert("Укажите дату начала аренды");return;}
const ed=document.getElementById("rentEndDate").value;
const et=document.getElementById("rentEndTime").value;
const priceVal=num(document.getElementById("rentPricePerDay").value);
const paidVal=num(document.getElementById("rentUpfrontPaid").value);
cars[i].rented=true;
cars[i].rentedSince=new Date(sd+"T"+(st||"00:00")).toISOString();
cars[i].rentedUntil=ed?new Date(ed+"T"+(et||"00:00")).toISOString():null;
if(priceVal>0) cars[i].price=priceVal;
cars[i].rentedPaid=paidVal;
cars[i].rentClientAlias=(document.getElementById("rentClientAlias").value||"").trim();
saveCars();
notifyOtherDevices(`Машина «${cars[i].name}» оформлена в аренду`);
addAppNotification({
type:"created",
car:cars[i].name,
sum:cars[i].price,
sumLabel:paidVal>0?`${space(cars[i].price)} ₽/сутки · предоплата ${space(paidVal)} ₽`:`${space(cars[i].price)} ₽/сутки`
});
if(i===selectedCarIdx) pricePerDay.value=space(cars[i].price);
updateCarPickerLabel();
flashSuccess(document.getElementById("rentSaveBtn"));
vibrate([15,25,15]);
playSyncSound(true);
setTimeout(()=>{
rentModal.classList.remove("open");
rentModalCarIdx=null;
renderCarManageList();
renderRentedList();
},280);
});

// сколько полных оплачиваемых суток накопилось у машины c к моменту atDate
// (та же формула, что и в rentAccrual, просто вычисленная "на срез времени" atDate)
function chargedDaysAsOf(c,atDate){
const start=new Date(c.rentedSince);
const elapsedMs=atDate-start;
if(!(elapsedMs>0)) return 0;
const totalHours=elapsedMs/3600000;
return Math.max(1,Math.floor(totalHours/24));
}

function rentAccrual(c){
const start=new Date(c.rentedSince);
const now=new Date();
let elapsedMs=now-start;
if(!(elapsedMs>0)) elapsedMs=0;
const totalHours=elapsedMs/3600000;
const fullDays=Math.floor(totalHours/24);
const remHours=totalHours-fullDays*24;
const paid=c.rentedPaid||0;
const startOfToday=new Date(now.getFullYear(),now.getMonth(),now.getDate(),0,0,0,0);

if(settings.billingMode==="persecond"){
// посекундное начисление: сумма растёт непрерывно и пропорционально прошедшему времени,
// без деления на "сутки" — просто цена/сутки, размазанная по секундам
const cost=elapsedMs/86400000*c.price;
const remaining=Math.max(0,cost-paid);
const overlapStart=start>startOfToday?start:startOfToday;
const todayMs=Math.max(0,now-overlapStart);
const today=todayMs/86400000*c.price;
return {fullDays,remHours:Math.floor(remHours),cost,paid,remaining,today};
}

// сутки оплачиваются целиком с момента начала аренды (день 1 — сразу целиком);
// текущие неполные вторые и следующие сутки — льготный период, бесплатно, пока не завершатся
const chargedDays=Math.max(1,fullDays);
const cost=chargedDays*c.price;
const remaining=Math.max(0,cost-paid);
// сумма за сегодня: сколько суток стало платным именно сегодня (считая с 00:00 текущего дня)
const chargedBeforeToday=chargedDaysAsOf(c,startOfToday);
const chargedNow=chargedDaysAsOf(c,now);
const todayDays=Math.max(0,chargedNow-chargedBeforeToday);
const today=todayDays*c.price;
return {fullDays,remHours:Math.floor(remHours),cost,paid,remaining,today};
}

function renderRentedList(){
const wrap=document.getElementById("rentedList");
wrap.innerHTML="";
const rentedCars=cars.map((c,i)=>({c,i})).filter(o=>o.c.rented);
if(!rentedCars.length){
wrap.innerHTML=`<div class="carEmptyState"><div class="historyEmptyIcon">🔑</div>Сейчас ни одна машина не в аренде</div>`;
return;
}
rentedCars.forEach(({c,i})=>{
const item=document.createElement("div");
item.className="carItem rentedCard";
item.dataset.idx=i;
const acc=c.rentedSince?rentAccrual(c):null;
item.innerHTML=`<div class="rentedCardTop">`+
`<div class="historyAvatar">${c.photo?`<img src="${c.photo}" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;">`:"🚗"}</div>`+
`<div class="rentedCardInfo">`+
`<div class="historyItemCar">${c.name}</div>`+
`<div class="historyItemDate">${space(c.price)} ₽/сутки</div>`+
`</div>`+
`<button type="button" class="carReturnBtn">Вернули</button>`+
`</div>`+
(c.rentClientAlias?`<div class="historyItemChips"><span class="historyChip">👤 ${escapeHtml(c.rentClientAlias)}</span></div>`:"")+
(c.rentedSince?`<div class="historyItemChips">`+
`<span class="historyChip">🕓 с ${fmtDateTime(new Date(c.rentedSince))}</span>`+
(c.rentedUntil?`<span class="historyChip">🏁 до ${fmtDateTime(new Date(c.rentedUntil))}</span>`:"")+
(acc?`<span class="historyChip chipAccent" data-field="elapsed">⏳ ${acc.fullDays} дн. ${acc.remHours} ч.</span>`:"")+
(acc?`<span class="historyChip chipToday" data-field="today">📅 За сегодня: ${space(acc.today)} ₽</span>`:"")+
`</div>`:"")+
(acc?`<div class="rentedAccruedBig"><span data-field="remainingAmt">${space(acc.remaining)} ₽</span><span data-field="remainingSub">${acc.paid>0?`к доплате · начислено ${space(acc.cost)} ₽, внесено ${space(acc.paid)} ₽`:"начислено на данный момент"}</span></div>`:"");
item.querySelector(".carReturnBtn").addEventListener("click",()=>{
openCompleteRentModal(i);
});
wrap.appendChild(item);
});
}
// раз в секунду обновляем только текст начисления (не пересобираем весь DOM списка —
// это раньше вызывало заметные "подёргивания" интерфейса каждую секунду на слабых телефонах)
function updateRentedAccruals(){
const wrap=document.getElementById("rentedList");
if(!wrap) return;
const items=wrap.querySelectorAll(".rentedCard[data-idx]");
if(!items.length) return;
items.forEach(item=>{
const i=parseInt(item.dataset.idx,10);
const c=cars[i];
if(!c||!c.rented||!c.rentedSince) return;
const acc=rentAccrual(c);
const elapsedEl=item.querySelector('[data-field="elapsed"]');
if(elapsedEl) elapsedEl.textContent=`⏳ ${acc.fullDays} дн. ${acc.remHours} ч.`;
const todayEl=item.querySelector('[data-field="today"]');
if(todayEl) todayEl.textContent=`📅 За сегодня: ${space(acc.today)} ₽`;
const amtEl=item.querySelector('[data-field="remainingAmt"]');
if(amtEl) amtEl.textContent=`${space(acc.remaining)} ₽`;
const subEl=item.querySelector('[data-field="remainingSub"]');
if(subEl) subEl.textContent=acc.paid>0?`к доплате · начислено ${space(acc.cost)} ₽, внесено ${space(acc.paid)} ₽`:"начислено на данный момент";
});
}
setInterval(()=>{
  const list=document.getElementById('rentedList');
  const drawer=document.getElementById('page2Drawer');
  if(list && drawer && drawer.classList.contains('open')) updateRentedAccruals();
},2000);

// ---------- модалка завершения аренды (оплата и долг) ----------
let completeRentCarIdx=null;
const completeRentModal=document.getElementById("completeRentModal");
function openCompleteRentModal(i){
completeRentCarIdx=i;
const c=cars[i];
const acc=rentAccrual(c);
document.getElementById("completeRentCarName").textContent=c.name;
document.getElementById("completeRentInfo").innerHTML=
`${space(acc.cost)} ₽<span>начислено за всё время аренды${acc.paid>0?" · внесено ранее "+space(acc.paid)+" ₽":""}</span>`;
document.getElementById("completeRentPay").value=space(Math.round(acc.remaining));
completeRentModal.classList.add("open");
}
function closeCompleteRentModal(){
completeRentModal.classList.remove("open");
completeRentCarIdx=null;
renderCarManageList();
}
document.getElementById("completeRentPay").addEventListener("input",e=>{
let v=e.target.value.replace(/\D/g,'');
e.target.value=space(v);
});
document.getElementById("completeRentCloseBtn").addEventListener("click",closeCompleteRentModal);
document.getElementById("completeRentCancelBtn").addEventListener("click",closeCompleteRentModal);
completeRentModal.addEventListener("click",e=>{
if(e.target.id==="completeRentModal") closeCompleteRentModal();
});
document.getElementById("completeRentSaveBtn").addEventListener("click",()=>{
if(completeRentCarIdx===null) return;
const i=completeRentCarIdx;
const c=cars[i];
const acc=rentAccrual(c);
const payNow=num(document.getElementById("completeRentPay").value);
const totalPaid=acc.paid+payNow;
const toPay=acc.cost-totalPaid;
const startD=new Date(c.rentedSince);
const now=new Date();
const pad=n=>("0"+n).slice(-2);
addHistoryEntry({
car:c.name,
start:fmtDateTime(startD),
end:fmtDateTime(now),
term:`${acc.fullDays} дн.${acc.remHours?" "+acc.remHours+" ч.":""}`,
rentalSum:acc.cost,
oldDebt:0,
paid:totalPaid,
toPay:toPay,
raw:{
carName:c.name,
pricePerDay:c.price,
pricePerHour:0,
startDate:startD.getFullYear()+"-"+pad(startD.getMonth()+1)+"-"+pad(startD.getDate()),
startTime:pad(startD.getHours())+":"+pad(startD.getMinutes()),
oldDebt:0,
paid:totalPaid
},
when:pad(now.getDate())+"."+pad(now.getMonth()+1)+" "+pad(now.getHours())+":"+pad(now.getMinutes()),
dayKey:now.getFullYear()+"-"+pad(now.getMonth()+1)+"-"+pad(now.getDate())
});
cars[i].rented=false;
cars[i].rentedSince=null;
cars[i].rentedUntil=null;
cars[i].rentedPaid=0;
saveCars();
notifyOtherDevices(`Машина «${c.name}» возвращена из аренды`);
addAppNotification({
type:"completed",
car:c.name,
sum:acc.cost,
sumLabel:toPay>0?`Внесено ${space(totalPaid)} ₽ · остался долг ${space(Math.round(toPay))} ₽`:`Внесено ${space(totalPaid)} ₽ · полностью оплачено`
});
flashSuccess(document.getElementById("completeRentSaveBtn"));
vibrate([15,25,15]);
playSyncSound(true);
setTimeout(()=>{
closeCompleteRentModal();
renderCarManageList();
renderRentedList();
},280);
});

// ---------- анимированное подтверждение удаления/очистки с вибро откликом ----------
function vibrate(pattern){
try{if(navigator.vibrate) navigator.vibrate(pattern);}catch(e){}
}
function flashSuccess(el){
if(!el) return;
el.classList.remove("btnSuccessFlash");
void el.offsetWidth;
el.classList.add("btnSuccessFlash");
}
let confirmCallback=null;
const confirmModal=document.getElementById("confirmModal");
function showConfirm(opts){
document.getElementById("confirmTitle").textContent=opts.title||"Удалить?";
document.getElementById("confirmMessage").textContent=opts.message||"Это действие нельзя отменить";
document.getElementById("confirmOkBtn").textContent=opts.confirmText||"Удалить";
confirmCallback=opts.onConfirm||null;
confirmModal.classList.add("open");
const icon=document.getElementById("confirmIcon");
icon.style.animation="none";
void icon.offsetWidth;
icon.style.animation="";
vibrate(15);
}
function closeConfirm(){
confirmModal.classList.remove("open");
confirmCallback=null;
}
document.getElementById("confirmModalCloseBtn").addEventListener("click",closeConfirm);
document.getElementById("confirmCancelBtn").addEventListener("click",closeConfirm);
confirmModal.addEventListener("click",e=>{
if(e.target.id==="confirmModal") closeConfirm();
});
document.getElementById("confirmOkBtn").addEventListener("click",()=>{
const cb=confirmCallback;
closeConfirm();
vibrate([20,30,20]);
if(cb) cb();
});

function addBlankCar(){
if(typeof subscriptionBlocksNewCar==="function" && subscriptionBlocksNewCar()){
vibrate([40,40,40]);
if(typeof openSubscriptionModal==="function") openSubscriptionModal();
return;
}
cars.push({name:"Новый автомобиль",price:0,rented:false,rentedSince:null,rentedUntil:null,rentedPaid:0,reserved:false,logo:""});
saveCars();
renderCarManageList();
renderCarPickerList();
vibrate(12);
flashSuccess(document.getElementById("carAddTopBtn"));
requestAnimationFrame(()=>{
const wrap=document.getElementById("carManageList");
const lastCard=wrap.lastElementChild;
if(lastCard){
lastCard.scrollIntoView({behavior:"smooth",block:"nearest"});
lastCard.classList.add("carCardNewFlash");
setTimeout(()=>lastCard.classList.remove("carCardNewFlash"),650);
const nameInput=lastCard.querySelector(".carEditName");
if(nameInput){nameInput.focus();nameInput.select();}
}
});
}
document.getElementById("carAddTopBtn").addEventListener("click",addBlankCar);

document.getElementById("carPickerBtn").addEventListener("click",()=>{
renderCarPickerList();
document.getElementById("carPickerModal").classList.add("open");
});
document.getElementById("carPickerCloseBtn").addEventListener("click",()=>{
document.getElementById("carPickerModal").classList.remove("open");
});
document.getElementById("carPickerModal").addEventListener("click",e=>{
if(e.target.id==="carPickerModal") e.target.classList.remove("open");
});

updateCarPickerLabel();

// ---------- вкладки второй страницы (Автопарк / В аренде / История) ----------
const page2Tabs=document.querySelectorAll(".page2Tab");
const page2Panels=document.querySelectorAll(".page2Panel");
const page2TabIndicator=document.getElementById("page2TabIndicator");
function updatePage2TabIndicator(){
const activeTab=document.querySelector(".page2Tab.active");
if(!activeTab||!page2TabIndicator) return;
page2TabIndicator.style.left=activeTab.offsetLeft+"px";
page2TabIndicator.style.width=activeTab.offsetWidth+"px";
}
function selectPage2Tab(tab){
page2Tabs.forEach(btn=>btn.classList.toggle("active",btn.dataset.tab===tab));
page2Panels.forEach(p=>p.classList.toggle("active",p.dataset.panel===tab));
updatePage2TabIndicator();
const addBtn=document.getElementById("carAddTopBtn");
if(addBtn) addBtn.style.display=(tab==="fleet")?"flex":"none";
if(tab==="fleet") renderCarManageList();
if(tab==="rented") renderRentedList();
if(tab==="history"){page2HistoryDay=null;renderHistory();}
}
page2Tabs.forEach(btn=>btn.addEventListener("click",()=>selectPage2Tab(btn.dataset.tab)));
window.addEventListener("resize",()=>updatePage2TabIndicator());

// ---------- история расчётов (свайп слева открывает, свайп вправо закрывает) ----------
const HISTORY_KEY="xcarHistory";
function loadHistory(){
try{
const raw=localStorage.getItem(HISTORY_KEY);
const parsed=raw?JSON.parse(raw):[];
if(!Array.isArray(parsed)) return [];
// у старых записей (сохранённых до появления dayKey) проставляем настоящую дату один раз,
// чтобы они не "зависали" отдельно от месяцев и корректно удалялись при очистке
let changed=false;
parsed.forEach(h=>{
if(!h.dayKey){
h.dayKey=historyDayKey(h);
changed=true;
}
});
if(changed){
try{localStorage.setItem(HISTORY_KEY, JSON.stringify(parsed.slice(0,50)));}catch(e){}
}
return parsed;
}catch(e){return [];}
}
function saveHistory(){
try{localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(0,50)));}catch(e){}
markDirty();
}
let history=loadHistory();

function isSameHistoryEntry(a,b){
return a.car===b.car&&a.start===b.start&&a.end===b.end&&a.term===b.term&&
a.rentalSum===b.rentalSum&&a.oldDebt===b.oldDebt&&a.paid===b.paid&&a.toPay===b.toPay;
}
function addHistoryEntry(entry){
// не дублируем в истории один и тот же расчёт, если он совпадает с самой последней записью
// (например, при повторном нажатии «Рассчитать» без изменения данных)
const last=history[0];
if(last&&isSameHistoryEntry(last,entry)) return;
history.unshift(entry);
saveHistory();
renderHistory();
}

function buildHistoryList(list,filterFn,limit){
list.innerHTML="";
let indices=history.map((h,idx)=>idx).filter(idx=>!filterFn||filterFn(history[idx]));
if(limit) indices=indices.slice(0,limit);
if(!indices.length){
list.innerHTML=`<div class="historyEmpty"><div class="historyEmptyIcon">🗂️</div>История пуста.<br>Она заполнится после первого расчёта</div>`;
return;
}
indices.forEach(i=>{
const h=history[i];
const item=document.createElement("div");
item.className="historyItem";
const paidOff=h.toPay<=0;
item.innerHTML=`<div class="historyItemFill"></div>`+
`<button type="button" class="historyDeleteBtn" title="Удалить">🗑️</button>`+
`<div class="historyItemRow">`+
`<div class="historyAvatar">🚗</div>`+
`<div class="historyItemMain">`+
`<div class="historyItemTop">`+
`<div class="historyItemCar">${h.car}</div>`+
`<div class="historyItemSum${paidOff?' sumPaid':''}">${space(h.toPay)} ₽</div>`+
`</div>`+
`<div class="historyItemDate">🗓️ ${h.start}${h.end?" → "+h.end:""}</div>`+
`<div class="historyItemChips">`+
`<span class="historyChip">${h.term}</span>`+
`<span class="historyChip">Оплачено ${space(h.paid)} ₽</span>`+
(paidOff?`<span class="historyChip chipAccent">✓ оплачено</span>`:"")+
`</div>`+
`<div class="historyItemWhen">Расчёт: ${h.when}</div>`+
`</div>`+
`</div>`;
item.querySelector(".historyDeleteBtn").addEventListener("click",(e)=>{
e.stopPropagation();
showConfirm({
title:"Удалить запись?",
message:`Расчёт «${h.car}» на ${space(h.toPay)} ₽ будет удалён из истории.`,
confirmText:"Удалить",
onConfirm:()=>{
history.splice(i,1);
saveHistory();
renderHistory();
}
});
});
// восстановление в калькулятор только по удержанию 2 секунды (с эффектом заполнения),
// чтобы случайное касание записи не перекидывало сразу в калькулятор
(function attachHoldToRestore(){
const RESTORE_HOLD_MS=2000;
const fill=item.querySelector(".historyItemFill");
let holdTimer=null,startX=0,startY=0;
function cancelHold(){
if(!holdTimer) return;
clearTimeout(holdTimer);
holdTimer=null;
item.classList.remove("holding");
fill.style.transition="clip-path .25s ease";
fill.style.clipPath="inset(0 100% 0 0)";
}
function onMove(e){
if(!holdTimer) return;
const dx=Math.abs(e.clientX-startX),dy=Math.abs(e.clientY-startY);
if(dx>10||dy>10) cancelHold();
}
item.addEventListener("pointerdown",e=>{
if(e.target.closest(".historyDeleteBtn")) return;
startX=e.clientX;startY=e.clientY;
item.classList.add("holding");
fill.style.transition="none";
fill.style.clipPath="inset(0 100% 0 0)";
void fill.offsetWidth;
fill.style.transition=`clip-path ${RESTORE_HOLD_MS}ms linear`;
requestAnimationFrame(()=>{fill.style.clipPath="inset(0 0% 0 0)";});
vibrate(8);
holdTimer=setTimeout(()=>{
holdTimer=null;
item.classList.remove("holding");
vibrate([15,30,15]);
restoreFromHistory(h);
},RESTORE_HOLD_MS);
});
item.addEventListener("pointermove",onMove);
item.addEventListener("pointerup",cancelHold);
item.addEventListener("pointerleave",cancelHold);
item.addEventListener("pointercancel",cancelHold);
})();
list.appendChild(item);
});
}

function restoreFromHistory(h){
if(!h.raw){alert("Для этой записи нет данных для восстановления");return;}
const r=h.raw;
const carIdx=r.carName?cars.findIndex(c=>c.name===r.carName):-1;
selectedCarIdx=carIdx>=0?carIdx:null;
pricePerDay.value=space(r.pricePerDay);
pricePerHour.value=space(r.pricePerHour);
startDate.value=r.startDate||"";
startTime.value=r.startTime||"";
oldDebt.value=space(r.oldDebt);
paid.value=space(r.paid);
const now=new Date();
const pad=n=>("0"+n).slice(-2);
endDate.value=now.getFullYear()+"-"+pad(now.getMonth()+1)+"-"+pad(now.getDate());
endTime.value=pad(now.getHours())+":"+pad(now.getMinutes());
updateCarPickerLabel();
closeHistory();
closePage2();
calculate();
}
// ---------- группировка истории по дням (папки) для вкладки "История" в Меню ----------
const RU_MONTHS=["января","февраля","марта","апреля","мая","июня","июля","августа","сентября","октября","ноября","декабря"];
function historyDayKey(h){
if(h.dayKey) return h.dayKey;
const m=(h.when||"").match(/^(\d{2})\.(\d{2})/);
if(m) return new Date().getFullYear()+"-"+m[2]+"-"+m[1];
// совсем без даты (старые записи) — считаем сегодняшним днём, чтобы запись не "зависала"
// вне месяцев и попадала в обычную очистку по месяцу
const n=new Date();
const p=x=>("0"+x).slice(-2);
return n.getFullYear()+"-"+p(n.getMonth()+1)+"-"+p(n.getDate());
}
function dayKeyLabel(key){
const parts=key.split("-");
if(parts.length!==3) return "Без даты";
const d=parseInt(parts[2],10),m=parseInt(parts[1],10)-1;
return `${d} ${RU_MONTHS[m]||""}`;
}
function carsWord(n){
const n10=n%10,n100=n%100;
if(n100>=11&&n100<=14) return "записей";
if(n10===1) return "запись";
if(n10>=2&&n10<=4) return "записи";
return "записей";
}
let page2HistoryDay=null;
function renderPage2History(){
const wrap=document.getElementById("page2HistoryList");
const clearBtn=document.getElementById("page2HistoryClearBtn");
wrap.innerHTML="";
if(!history.length){
wrap.innerHTML=`<div class="historyEmpty"><div class="historyEmptyIcon">🗂️</div>История пуста.<br>Она заполнится после первого расчёта</div>`;
if(clearBtn) clearBtn.style.display="none";
return;
}
if(page2HistoryDay===null){
const groups=[];
const byKey={};
history.forEach(h=>{
const key=historyDayKey(h);
if(!byKey[key]){
byKey[key]={key,total:0,count:0};
groups.push(byKey[key]);
}
byKey[key].total+=(h.paid||0);
byKey[key].count++;
});
groups.forEach(g=>{
const folder=document.createElement("div");
folder.className="historyDayFolder";
folder.innerHTML=`<div class="historyDayFolderIcon">📅</div>`+
`<div class="historyDayFolderInfo">`+
`<div class="historyDayFolderDate">${dayKeyLabel(g.key)}</div>`+
`<div class="historyDayFolderCount">${g.count} ${carsWord(g.count)}</div>`+
`</div>`+
`<div class="historyDayFolderSum">${space(g.total)} ₽</div>`;
folder.addEventListener("click",()=>{
page2HistoryDay=g.key;
renderPage2History();
});
wrap.appendChild(folder);
});
if(clearBtn) clearBtn.style.display="";
}else{
const backRow=document.createElement("div");
backRow.className="historyDayBackRow";
backRow.innerHTML=`<button type="button" class="historyDayBackBtn">← Все дни</button>`+
`<div class="historyDayBackTitle">${dayKeyLabel(page2HistoryDay)}</div>`;
wrap.appendChild(backRow);
backRow.querySelector(".historyDayBackBtn").addEventListener("click",()=>{
page2HistoryDay=null;
renderPage2History();
});
const dayList=document.createElement("div");
wrap.appendChild(dayList);
const dayKeySnapshot=page2HistoryDay;
buildHistoryList(dayList,h=>historyDayKey(h)===dayKeySnapshot);
if(clearBtn) clearBtn.style.display="none";
}
}

const HISTORY_DRAWER_LIMIT=10;
function renderHistory(){
buildHistoryList(document.getElementById("historyList"),null,HISTORY_DRAWER_LIMIT);
renderPage2History();
const subEl=document.getElementById("historySubtitle");
if(subEl){
subEl.textContent=history.length>HISTORY_DRAWER_LIMIT
?`Последние ${HISTORY_DRAWER_LIMIT} из ${history.length}`
:`Всего записей: ${history.length}`;
}
}
renderHistory();

// ---------- удаление истории по месяцам: кнопку нужно удержать несколько секунд ----------
const RU_MONTHS_NOM=["Январь","Февраль","Март","Апрель","Май","Июнь","Июль","Август","Сентябрь","Октябрь","Ноябрь","Декабрь"];
function historyMonthKey(h){
return historyDayKey(h).slice(0,7);
}
function monthKeyLabel(key){
const parts=key.split("-");
if(parts.length!==2) return "Без даты";
const m=parseInt(parts[1],10)-1;
return `${RU_MONTHS_NOM[m]||""} ${parts[0]}`;
}
const deleteMonthModal=document.getElementById("deleteMonthModal");
function renderDeleteMonthList(){
const wrap=document.getElementById("deleteMonthList");
wrap.innerHTML="";
if(!history.length){
wrap.innerHTML=`<div class="historyEmpty">История уже пуста</div>`;
return;
}
const groups=[];
const byKey={};
history.forEach(h=>{
const key=historyMonthKey(h);
if(!byKey[key]){byKey[key]={key,count:0,total:0};groups.push(byKey[key]);}
byKey[key].count++;
byKey[key].total+=(h.paid||0);
});
groups.forEach(g=>{
const row=document.createElement("div");
row.className="historyDayFolder";
row.innerHTML=`<div class="historyDayFolderIcon">🗑️</div>`+
`<div class="historyDayFolderInfo">`+
`<div class="historyDayFolderDate">${monthKeyLabel(g.key)}</div>`+
`<div class="historyDayFolderCount">${g.count} ${carsWord(g.count)}</div>`+
`</div>`+
`<div class="historyDayFolderSum" style="color:#c62828;">${space(g.total)} ₽</div>`;
row.addEventListener("click",()=>{
showConfirm({
title:"Удалить месяц?",
message:`Все записи за «${monthKeyLabel(g.key)}» (${g.count}) будут удалены. Это действие нельзя отменить.`,
confirmText:"Удалить",
onConfirm:()=>{
history=history.filter(h=>historyMonthKey(h)!==g.key);
saveHistory();
renderHistory();
renderDeleteMonthList();
if(!history.length) deleteMonthModal.classList.remove("open");
}
});
});
wrap.appendChild(row);
});
}
function openDeleteMonthModal(){
if(!history.length) return;
renderDeleteMonthList();
deleteMonthModal.classList.add("open");
}
document.getElementById("deleteMonthCloseBtn").addEventListener("click",()=>deleteMonthModal.classList.remove("open"));
deleteMonthModal.addEventListener("click",e=>{
if(e.target.id==="deleteMonthModal") deleteMonthModal.classList.remove("open");
});

function attachHoldToClear(btnId,holdMs){
const btn=document.getElementById(btnId);
if(!btn) return;
const fill=btn.querySelector(".historyClearFill");
const labelEl=btn.querySelector(".historyClearLabelText");
const restLabel=labelEl.textContent;
let holdTimer=null,startTs=0,rafId=null;
function tick(){
if(!btn.classList.contains("holding")) return;
const elapsed=Date.now()-startTs;
const remain=Math.max(0,Math.ceil((holdMs-elapsed)/1000));
labelEl.textContent=`Держите… ${remain} с`;
rafId=requestAnimationFrame(tick);
}
function startHold(){
if(!history.length) return;
btn.classList.add("holding");
startTs=Date.now();
fill.style.transition="none";
fill.style.width="0%";
void fill.offsetWidth;
fill.style.transition=`width ${holdMs}ms linear`;
requestAnimationFrame(()=>{fill.style.width="100%";});
vibrate(10);
tick();
holdTimer=setTimeout(finishHold,holdMs);
}
function resetVisual(){
btn.classList.remove("holding");
fill.style.transition="width .25s ease";
fill.style.width="0%";
labelEl.textContent=restLabel;
}
function cancelHold(){
if(!holdTimer) return;
clearTimeout(holdTimer);
holdTimer=null;
if(rafId){cancelAnimationFrame(rafId);rafId=null;}
resetVisual();
}
function finishHold(){
holdTimer=null;
if(rafId){cancelAnimationFrame(rafId);rafId=null;}
resetVisual();
vibrate([20,40,20,40,20]);
openDeleteMonthModal();
}
btn.addEventListener("pointerdown",e=>{e.preventDefault();startHold();});
btn.addEventListener("pointerup",cancelHold);
btn.addEventListener("pointerleave",cancelHold);
btn.addEventListener("pointercancel",cancelHold);
}
attachHoldToClear("page2HistoryClearBtn",30000);

const historyDrawer=document.getElementById("historyDrawer");
const historyOverlay=document.getElementById("historyOverlay");
function openHistory(){
historyDrawer.classList.add("open");
historyOverlay.classList.add("open");
}
function closeHistory(){
historyDrawer.classList.remove("open");
historyOverlay.classList.remove("open");
}
document.getElementById("historyHandle").addEventListener("click",openHistory);
document.getElementById("historyCloseBtn").addEventListener("click",closeHistory);
historyOverlay.addEventListener("click",()=>{
if(window.__suppressOverlayClickUntil&&Date.now()<window.__suppressOverlayClickUntil) return;
closeHistory();
});
function triggerRipple(btn){
const fx=btn.querySelector(".navBtnRippleFx");
if(!fx) return;
fx.classList.remove("animate");
void fx.offsetWidth;
fx.classList.add("animate");
}
document.querySelectorAll(".navBtn").forEach(btn=>{
btn.addEventListener("pointerdown",()=>{triggerRipple(btn);vibrate(10);});
});
document.getElementById("navLeftBtn").addEventListener("click",openHistory);

// ---------- вторая страница (меню/настройки), открывается свайпом влево ----------
const page2Drawer=document.getElementById("page2Drawer");
const page2Overlay=document.getElementById("page2Overlay");
function openPage2(){
page2Drawer.classList.add("open");
page2Overlay.classList.add("open");
renderCarManageList();
renderRentedList();
renderHistory();
requestAnimationFrame(updatePage2TabIndicator);
}
function closePage2(){
page2Drawer.classList.remove("open");
page2Overlay.classList.remove("open");
}
document.getElementById("page2Handle").addEventListener("click",openPage2);
document.getElementById("page2CloseBtn").addEventListener("click",closePage2);
page2Overlay.addEventListener("click",()=>{
if(window.__suppressOverlayClickUntil&&Date.now()<window.__suppressOverlayClickUntil) return;
closePage2();
});
document.getElementById("navRightBtn").addEventListener("click",openPage2);

// свайп: от левого края экрана вправо — открыть историю; от правого края влево — открыть вторую страницу;
// обратный свайп (когда открыта) — закрыть и вернуться к текущему расчёту
(function setupSwipe(){
let startX=0,startY=0,tracking=false,fromEdge=false,fromEdgeRight=false,gestureHandled=false;
const EDGE_ZONE=28,THRESHOLD=60;

function onStart(x,y){
startX=x;startY=y;
tracking=true;
gestureHandled=false;
fromEdge=startX<=EDGE_ZONE;
fromEdgeRight=startX>=window.innerWidth-EDGE_ZONE;
}
function onMove(x,y){
if(!tracking) return;
const dx=x-startX,dy=y-startY;
if(Math.abs(dx)<Math.abs(dy)) return; // вертикальная прокрутка — игнор
const historyOpen=historyDrawer.classList.contains("open");
const page2Open=page2Drawer.classList.contains("open");
const calculatorActive=!historyOpen&&!page2Open;
if(!calculatorActive){return;}
if(calculatorActive&&fromEdge&&dx>0){
gestureHandled=true;
historyDrawer.classList.add("dragging");
const shift=Math.min(dx,340);
historyDrawer.style.transform=`translateX(${shift-340}px)`;
historyOverlay.classList.add("open");
}else if(calculatorActive&&fromEdgeRight&&dx<0){
gestureHandled=true;
page2Drawer.classList.add("dragging");
const shift=Math.max(dx,-340);
page2Drawer.style.transform=`translateX(${shift+340}px)`;
page2Overlay.classList.add("open");
}
}
function onEnd(x){
if(!tracking) return;
tracking=false;
historyDrawer.classList.remove("dragging");
historyDrawer.style.transform="";
page2Drawer.classList.remove("dragging");
page2Drawer.style.transform="";
const dx=x-startX;
const historyOpen=historyDrawer.classList.contains("open");
const page2Open=page2Drawer.classList.contains("open");
if(!historyOpen&&!page2Open&&fromEdge&&dx>THRESHOLD){
openHistory();
}else if(!historyOpen&&!page2Open&&fromEdgeRight&&dx<-THRESHOLD){
openPage2();
}else{
if(!historyOpen) historyOverlay.classList.remove("open");
if(!page2Open) page2Overlay.classList.remove("open");
}
// на реальном свайпе браузер может выстрелить "призрачный" клик по элементу
// под курсором сразу после отпускания (особенно заметно с мышью) — на короткое
// время игнорируем клики по оверлеям, чтобы это не выглядело как отмена действия
if(gestureHandled){
window.__suppressOverlayClickUntil=Date.now()+450;
}
gestureHandled=false;
}

document.addEventListener("touchstart",e=>{
const t=e.touches[0];
onStart(t.clientX,t.clientY);
},{passive:true});
document.addEventListener("touchmove",e=>{
const t=e.touches[0];
onMove(t.clientX,t.clientY);
},{passive:true});
document.addEventListener("touchend",e=>{
const t=e.changedTouches[0];
onEnd(t.clientX);
});

// поддержка свайпа мышью (для тестирования на компьютере) — те же пороги,
// но без реакции на обычные клики: жест засчитывается только при реальном движении
let mouseDown=false;
document.addEventListener("mousedown",e=>{
if(e.button!==0) return;
mouseDown=true;
onStart(e.clientX,e.clientY);
});
document.addEventListener("mousemove",e=>{
if(!mouseDown) return;
onMove(e.clientX,e.clientY);
});
document.addEventListener("mouseup",e=>{
if(!mouseDown) return;
mouseDown=false;
onEnd(e.clientX);
});
})();

function fmtHistoryDateTime(dateStr,timeStr){
if(!dateStr) return "";
const d=new Date(dateStr+"T00:00");
return fmtDate(d)+(timeStr?" "+timeStr:"");
}

function getDuration(){
if(!startDate.value||!endDate.value){
alert("Заполните дату начала и окончания");
return null;
}
const hasTime=!!(startTime.value&&endTime.value);
let start,end;
if(hasTime){
start=new Date(startDate.value+"T"+startTime.value);
end=new Date(endDate.value+"T"+endTime.value);
}else{
start=new Date(startDate.value+"T00:00");
end=new Date(endDate.value+"T00:00");
}
const diffMs=end-start;
if(diffMs<0){alert("Дата/время окончания должны быть позже начала");return null;}

if(hasTime){
if(diffMs===0){alert("Дата/время окончания должны быть позже начала");return null;}
const totalHoursExact=diffMs/3600000;
const totalHoursCeil=Math.ceil(totalHoursExact-1e-9);
const fullDays=Math.floor(totalHoursCeil/24);
const remHours=totalHoursCeil-fullDays*24;
return {fullDays,remHours,hasTime,start,end};
}else{
const fullDays=Math.round(diffMs/86400000);
if(fullDays<=0){alert("Дата окончания должна быть позже даты начала");return null;}
return {fullDays,remHours:0,hasTime,start,end};
}
}

function fmtDate(d){
return ("0"+d.getDate()).slice(-2)+"."+("0"+(d.getMonth()+1)).slice(-2)+"."+d.getFullYear();
}

function calculate(){
const dayPrice=num(pricePerDay.value);
const hourPrice=num(pricePerHour.value);
const oldDebtVal=num(oldDebt.value);
const paidVal=num(paid.value);

const dur=getDuration();
if(!dur) return;
const {fullDays,remHours}=dur;

// сутки оплачиваются целиком; если аренда уже началась (есть хотя бы 1 полная сутки),
// то "хвост" во второй/следующие сутки, пока они не станут полными, — бесплатно.
// почасовая цена используется только когда вся аренда короче одних суток.
const rentalSum=fullDays*dayPrice+(fullDays===0?remHours*hourPrice:0);
const totalWithDebt=rentalSum+oldDebtVal;
const toPay=totalWithDebt-paidVal;

result.innerText=
`Срок аренды: ${fullDays} дн.${remHours?" "+remHours+" ч.":""}\n`+
`Сумма за аренду: ${space(rentalSum)} ₽\n`+
`Старый долг: ${space(oldDebtVal)} ₽\n`+
`Оплачено: ${space(paidVal)} ₽\n`+
`Итого к оплате: ${space(toPay)} ₽`;

tableBody.innerHTML="";
const startInfoRow=document.getElementById("startInfoRow");
if(startInfoRow){
const startStr=fmtHistoryDateTime(startDate.value,startTime.value);
const endStr=fmtHistoryDateTime(endDate.value,endTime.value);
startInfoRow.textContent=endStr?`${startStr} → ${endStr}`:startStr;
}
const rows=[
["Автомобиль", (selectedCarIdx!==null&&cars[selectedCarIdx])?cars[selectedCarIdx].name:"—"],
["Срок аренды", `${fullDays} дн.${remHours?" "+remHours+" ч.":""}`],
["Сумма за аренду", space(rentalSum)+" ₽"],
["Старый долг", space(oldDebtVal)+" ₽"],
["Оплачено", space(paidVal)+" ₽"],
["Итого к оплате", space(toPay)+" ₽"]
];
rows.forEach(r=>{
let tr=document.createElement("tr");
tr.innerHTML=`<td>${r[0]}</td><td>${r[1]}</td>`;
tableBody.appendChild(tr);
});

document.getElementById("dailyBreakdown").style.display="none";

addHistoryEntry({
car:(selectedCarIdx!==null&&cars[selectedCarIdx])?cars[selectedCarIdx].name:"—",
start:fmtHistoryDateTime(startDate.value,startTime.value),
end:fmtHistoryDateTime(endDate.value,endTime.value),
term:`${fullDays} дн.${remHours?" "+remHours+" ч.":""}`,
rentalSum:rentalSum,
oldDebt:oldDebtVal,
paid:paidVal,
toPay:toPay,
raw:{
carName:(selectedCarIdx!==null&&cars[selectedCarIdx])?cars[selectedCarIdx].name:null,
pricePerDay:dayPrice,
pricePerHour:hourPrice,
startDate:startDate.value,
startTime:startTime.value,
oldDebt:oldDebtVal,
paid:paidVal
},
when:(()=>{const n=new Date();const p=x=>("0"+x).slice(-2);return p(n.getDate())+"."+p(n.getMonth()+1)+" "+p(n.getHours())+":"+p(n.getMinutes());})(),
dayKey:(()=>{const n=new Date();const p=x=>("0"+x).slice(-2);return n.getFullYear()+"-"+p(n.getMonth()+1)+"-"+p(n.getDate());})()
});
}

function showDetailed(){
const dayPrice=num(pricePerDay.value);
const hourPrice=num(pricePerHour.value);
const oldDebtVal=num(oldDebt.value);
const paidVal=num(paid.value);

const dur=getDuration();
if(!dur) return;
const {fullDays,remHours,start,end,hasTime}=dur;

// строим список дней: fullDays полных суток + (если есть) последний "хвост" в часах
const days=[];
for(let i=0;i<fullDays;i++){
let d=new Date(start);
d.setDate(d.getDate()+i);
days.push({
dateObj:d,
label:fmtDate(d),
amount:dayPrice
});
}
if(remHours>0){
let d=new Date(start);
d.setDate(d.getDate()+fullDays);
const isFree=fullDays>0;
days.push({
dateObj:d,
label:fmtDate(d)+` (${remHours} ч.)`+(isFree?" · льготный период":""),
amount:isFree?0:remHours*hourPrice,
free:isFree
});
}

// оплата распределяется по дням аренды начиная с 1-го дня (он тоже оплачивается на общих
// основаниях), старый долг сюда не подмешиваем — он просто прибавляется к итоговой сумме отдельно.
// неполные "льготные" сутки (бесплатный хвост, пока сутки не станут полными) в детализации не показываем.
let remainingPaid=paidVal;
const dailyList=document.getElementById("dailyList");
dailyList.innerHTML="";

let shownIdx=0;
days.forEach(day=>{
if(day.free) return;

shownIdx++;
const dateLabel=`${shownIdx}. ${day.label}`;

let status,paidAmount;
if(remainingPaid>=day.amount){
status="paid";
paidAmount=day.amount;
remainingPaid-=day.amount;
}else if(remainingPaid>0){
status="partial";
paidAmount=remainingPaid;
remainingPaid=0;
}else{
status="unpaid";
paidAmount=0;
}

let cls,statusText,amountText;
if(status==="paid"){
cls="dayPaid";
statusText="оплачено";
amountText=`${space(day.amount)} ₽`;
}else if(status==="partial"){
cls="dayPartial";
statusText="частично";
amountText=`${space(paidAmount)} из ${space(day.amount)} ₽`;
}else{
cls="dayUnpaid";
statusText="не оплачено";
amountText=`${space(day.amount)} ₽`;
}

const row=document.createElement("div");
row.className="dayRow "+cls;
row.innerHTML=`<span class="dayDate">${dateLabel}</span>`+
`<span class="dayAmount">${amountText}</span>`+
`<span class="dayStatus">${statusText}</span>`;
dailyList.appendChild(row);
});

const rentalSum=days.reduce((a,d)=>a+d.amount,0);
const totalWithDebt=rentalSum+oldDebtVal;
const toPay=totalWithDebt-paidVal;
document.getElementById("dailySummary").innerHTML=
`Сумма за аренду: ${space(rentalSum)} ₽<br>`+
`Старый долг: <span style="color:#e11d1d;">${space(oldDebtVal)} ₽</span><br>`+
`Оплачено за период аренды: ${space(paidVal)} ₽<br>`+
`Итого к оплате: ${space(toPay)} ₽`;

document.getElementById("dailyBreakdown").style.display="block";
}

async function sendReport(){
const detailBlock=document.getElementById("dailyBreakdown");
const isDetailOpen=detailBlock.style.display==="block";

if(isDetailOpen){
if(!document.getElementById("dailyList").children.length) return alert("Сначала сделайте расчёт");
}else{
if(!tableBody.children.length) return alert("Сначала сделайте расчёт");
}

const target=isDetailOpen?detailBlock:document.getElementById("reportBottom");
const card=document.querySelector(".card");
target.classList.add("exportSquare");
card.classList.add("exportSquare");
const canvas=await html2canvas(target,{backgroundColor:"#ffffff"});
target.classList.remove("exportSquare");
card.classList.remove("exportSquare");
canvas.toBlob(blob=>{
const file=new File([blob],isDetailOpen?"rental-detailed.png":"rental.png",{type:"image/png"});
if(navigator.share){navigator.share({files:[file]});}
else{alert("Отправка доступна только на телефоне");}
});
}

const logoBtn=document.getElementById("logoBtn");
const contactsModal=document.getElementById("contactsModal");
const modalCloseBtn=document.getElementById("modalCloseBtn");
const accountModal=document.getElementById("accountModal");
const accountModalCloseBtn=document.getElementById("accountModalCloseBtn");
function renderXcarHub(){
const a=settings.account||{};
const desc=document.getElementById("hubAccountDesc");
if(desc) desc.textContent=a.connected ? `Выполнен вход: ${a.username||"аккаунт"} · данные сохранены` : (a.username ? `Аккаунт ${a.username} сохранён на устройстве` : "Вход, регистрация и синхронизация");
const nd=document.getElementById("hubNotesDesc");
if(nd){const filled=quickNotes.filter(Boolean).length;nd.textContent=`${filled} из 8 заметок заполнено`;}
}
function openXcarHub(){
  renderXcarHub();
  contactsModal.classList.add("open");
  vibrate(8);
}
logoBtn.addEventListener("click",openXcarHub);
// Надёжное открытие логотипа/кнопки «Аренда авто XCAR» даже при перекрытии элементов интерфейса.
document.addEventListener("click",(e)=>{
  const target=e.target && e.target.closest ? e.target.closest("#logoBtn") : null;
  if(target){ e.preventDefault(); e.stopPropagation(); openXcarHub(); }
}, true);
modalCloseBtn.addEventListener("click",()=>contactsModal.classList.remove("open"));
contactsModal.addEventListener("click",(e)=>{if(e.target===contactsModal) contactsModal.classList.remove("open");});
document.getElementById("hubAccountBtn").addEventListener("click",()=>{contactsModal.classList.remove("open");renderStandaloneAuthModal();accountModal.classList.add("open");vibrate(8);});
document.getElementById("hubNotesBtn").addEventListener("click",()=>{contactsModal.classList.remove("open");openNotes();vibrate(8);});
document.getElementById("hubBlacklistBtn").addEventListener("click",openBlacklistPanel);
document.getElementById("hubSettingsBtn").addEventListener("click",openSettingsPanel);
accountModalCloseBtn.addEventListener("click",()=>accountModal.classList.remove("open"));
accountModal.addEventListener("click",e=>{if(e.target===accountModal) accountModal.classList.remove("open");});

// Резервный обработчик для тач/мыши: строки XCAR Hub всегда кликабельны.
document.addEventListener("click",(e)=>{
  const row=e.target.closest?.("#hubAccountBtn,#hubNotesBtn,#hubBlacklistBtn,#hubSettingsBtn");
  if(!row) return;
  if(row.id==="hubAccountBtn"){contactsModal.classList.remove("open");renderStandaloneAuthModal();accountModal.classList.add("open");vibrate(8);}
  else if(row.id==="hubNotesBtn"){contactsModal.classList.remove("open");openNotes();vibrate(8);}
  else if(row.id==="hubBlacklistBtn"){openBlacklistPanel();}
  else if(row.id==="hubSettingsBtn"){openSettingsPanel();}
  e.preventDefault(); e.stopImmediatePropagation();
},{capture:true});

// ---------- отдельное окно входа/регистрации по нажатию на «Аренда авто XCAR» ----------
let standaloneAuthMode="login";
function setStandaloneAuthMode(mode){
standaloneAuthMode=mode==="register"?"register":"login";
const loginTab=document.getElementById("standaloneAuthTabLogin");
const regTab=document.getElementById("standaloneAuthTabRegister");
const extra=document.getElementById("standaloneAccountRegisterExtra");
const loginBtn=document.getElementById("standaloneAccountLoginBtn");
const regBtn=document.getElementById("standaloneAccountRegisterBtn");
if(loginTab) loginTab.classList.toggle("active",standaloneAuthMode==="login");
if(regTab) regTab.classList.toggle("active",standaloneAuthMode==="register");
if(extra) extra.style.display=standaloneAuthMode==="register"?"":"none";
if(loginBtn) loginBtn.style.display=standaloneAuthMode==="login"?"":"none";
if(regBtn) regBtn.style.display=standaloneAuthMode==="register"?"":"none";
}
function syncStandaloneAuthFields(){
const a=settings.account||{};
const u=document.getElementById("standaloneAccountUsername");
const pw=document.getElementById("standaloneAccountPassword");
const em=document.getElementById("standaloneAccountEmail");
const ph=document.getElementById("standaloneAccountPhone");
if(u) u.value=a.username||"";
if(pw) pw.value=a.password||"";
if(em) em.value=a.email||"";
if(ph) ph.value=a.phone||"";
}
function renderStandaloneAuthModal(){
const a=settings.account||{};
syncStandaloneAuthFields();
setStandaloneAuthMode(standaloneAuthMode);
const status=document.getElementById("standaloneAccountStatus");
const row=document.getElementById("standaloneConnectedRow");
const card=document.querySelector(".authStandaloneCard");
if(!status||!row) return;
if(a.connected){
status.textContent=`Выполнен вход: «${a.username||"аккаунт"}». Данные сохранены.`;
row.style.display="";
if(card) card.style.display="none";
}else{
status.textContent=a.username?`Аккаунт «${a.username}» сохранён на устройстве. Можно войти снова без повторного ввода.` : "Вход не выполнен. После выхода данные аккаунта сохраняются на устройстве.";
row.style.display="none";
if(card) card.style.display="";
}
}
function setStandaloneAccountHint(text,isError){
const el=document.getElementById("standaloneAccountHint");
if(!el) return;
el.textContent=text;
el.style.color=isError?"#c62828":"#0a9a4a";
}
document.getElementById("standaloneAuthTabLogin").addEventListener("click",()=>setStandaloneAuthMode("login"));
document.getElementById("standaloneAuthTabRegister").addEventListener("click",()=>setStandaloneAuthMode("register"));
[
["standaloneAccountUsername","username"],["standaloneAccountPassword","password"],["standaloneAccountEmail","email"],["standaloneAccountPhone","phone"]
].forEach(([id,key])=>{
const el=document.getElementById(id);
if(el) el.addEventListener("input",e=>{settings.account[key]=e.target.value.trim();saveSettings();});
});
document.getElementById("standaloneAccountLoginBtn").addEventListener("click",async()=>{
const u=document.getElementById("standaloneAccountUsername");
const pw=document.getElementById("standaloneAccountPassword");
if(u) settings.account.username=u.value.trim();
if(pw) settings.account.password=pw.value;
saveSettings();
setStandaloneAccountHint("Вход…",false);
await doLogin();
const accountHint=document.getElementById("accountHint");
if(accountHint) setStandaloneAccountHint(accountHint.textContent||"",accountHint.style.color.includes("c62828"));
renderStandaloneAuthModal();
});
document.getElementById("standaloneAccountRegisterBtn").addEventListener("click",async()=>{
const u=document.getElementById("standaloneAccountUsername");
const pw=document.getElementById("standaloneAccountPassword");
const em=document.getElementById("standaloneAccountEmail");
const ph=document.getElementById("standaloneAccountPhone");
if(u) settings.account.username=u.value.trim();
if(pw) settings.account.password=pw.value;
if(em) settings.account.email=em.value.trim();
if(ph) settings.account.phone=ph.value.trim();
saveSettings();
setStandaloneAccountHint("Регистрация…",false);
await doRegister();
const accountHint=document.getElementById("accountHint");
if(accountHint) setStandaloneAccountHint(accountHint.textContent||"",accountHint.style.color.includes("c62828"));
renderStandaloneAuthModal();
});
document.getElementById("standaloneLogoutBtn").addEventListener("click",async()=>{
await unsubscribeFromPush();
settings.account.connected=false;
// ВАЖНО: username/password/email/phone намеренно НЕ очищаются.
saveSettings();
renderAccountUI();
renderStandaloneAuthModal();
setAccountHint("Вы вышли из аккаунта. Данные аккаунта сохранены на устройстве.",false);
setStandaloneAccountHint("Вы вышли. Логин и пароль сохранены для следующего входа.",false);
vibrate(15);
});
document.getElementById("standaloneSyncBtn").addEventListener("click",()=>{syncNow({manual:true});renderStandaloneAuthModal();});

// ---------- окно настроек приложения ----------
const settingsModal=document.getElementById("settingsModal");
function renderBillingModeUI(){
document.querySelectorAll(".billingModeOpt").forEach(btn=>{
btn.classList.toggle("active",btn.dataset.mode===settings.billingMode);
});
const hint=document.getElementById("billingFolderHint");
if(hint) hint.textContent=settings.billingMode==="persecond"?"Посекундно":"Предоплата за сутки";
}

// ---------- красивые "папки" настроек — раскрываются по нажатию ----------
document.querySelectorAll(".settingsFolderHeader").forEach(header=>{
header.addEventListener("click",()=>{
const folder=header.closest(".settingsFolder");
if(!folder) return;
folder.classList.toggle("open");
vibrate(8);
});
});

// ---------- тема оформления ----------
function renderThemeUI(){
document.querySelectorAll(".themeOpt").forEach(btn=>{
btn.classList.toggle("active",btn.dataset.theme===settings.theme);
});
const hint=document.getElementById("themeFolderHint");
if(hint) hint.textContent=settings.theme==="dark"?"Тёмная":"Белая";
}
document.querySelectorAll(".themeOpt").forEach(btn=>{
btn.addEventListener("click",()=>{
settings.theme=btn.dataset.theme;
saveSettings();
applyTheme();
renderThemeUI();
vibrate(12);
});
});

// ---------- новый / стандартный дизайн ----------
function renderUIStyle(){
const mode=settings.uiStyle==="new"?"new":"standard";
document.querySelectorAll(".uiStyleOpt").forEach(btn=>btn.classList.toggle("active",btn.dataset.uiStyle===mode));
const hint=document.getElementById("designFolderHint");
if(hint) hint.textContent=mode==="new"?"Новый премиальный":"Стандартный";
applyUIStyle();
}
document.querySelectorAll(".uiStyleOpt").forEach(btn=>{
btn.addEventListener("click",()=>{
settings.uiStyle=btn.dataset.uiStyle==="new"?"new":"standard";
saveSettings();
renderUIStyle();
// мягкая перерисовка интерфейса без потери данных
requestAnimationFrame(()=>{renderCarManageList();renderRentedList();renderHistory();});
vibrate([10,25,10]);
});
});
renderUIStyle();

// ---------- показать/скрыть стрелки навигации ----------
// слушаем "change" на самом чекбоксе (а не "click" на строке) — так браузер
// сам корректно переключает галочку по тапу на label, без гонки состояний
// на реальных сенсорных экранах (тот же приём, что и у переключателя push-уведомлений)
document.getElementById("navArrowsToggleCheck").addEventListener("change",(e)=>{
settings.showNavArrows=e.target.checked;
saveSettings();
applyNavArrowsVisibility();
renderNavArrowsUI();
vibrate(12);
});
function renderNavArrowsUI(){
const check=document.getElementById("navArrowsToggleCheck");
if(check) check.checked=settings.showNavArrows!==false;
const hint=document.getElementById("navFolderHint");
if(hint) hint.textContent=settings.showNavArrows!==false?"Стрелки показаны":"Стрелки скрыты";
}

function openSettingsPanel(){
contactsModal.classList.remove("open");
accountModal.classList.remove("open");
renderBillingModeUI();
renderAccountUI();
renderServerProfiles();
renderThemeUI();
renderNavArrowsUI();
renderSubscriptionUI();
renderAutoSyncUI();
const backupText=document.getElementById("settingsBackupText");
const backupHint=document.getElementById("settingsBackupHint");
if(backupText) backupText.value="";
if(backupHint) backupHint.textContent="";
settingsModal.classList.add("open");
vibrate(8);
}
const settingsOpenBtn=document.getElementById("settingsOpenBtn");
if(settingsOpenBtn) settingsOpenBtn.addEventListener("click",openSettingsPanel);
document.getElementById("settingsCloseBtn").addEventListener("click",()=>settingsModal.classList.remove("open"));
settingsModal.addEventListener("click",(e)=>{
if(e.target===settingsModal) settingsModal.classList.remove("open");
});
document.querySelectorAll(".billingModeOpt").forEach(btn=>{
btn.addEventListener("click",()=>{
settings.billingMode=btn.dataset.mode;
saveSettings();
markDirty();
renderBillingModeUI();
renderRentedList();
vibrate(12);
});
});

document.getElementById("settingsExportBtn").addEventListener("click",async()=>{
const backup={version:1,exportedAt:new Date().toISOString(),cars,history,settings};
const text=JSON.stringify(backup,null,2);
const ta=document.getElementById("settingsBackupText");
const hint=document.getElementById("settingsBackupHint");
ta.value=text;
try{
await navigator.clipboard.writeText(text);
hint.textContent="Готово — скопировано в буфер обмена ✓";
hint.style.color="#0a9a4a";
flashSuccess(document.getElementById("settingsExportBtn"));
}catch(e){
ta.focus();
ta.select();
hint.textContent="Текст готов — скопируйте вручную";
hint.style.color="#5a6270";
}
vibrate(15);
});

document.getElementById("settingsImportBtn").addEventListener("click",()=>{
const ta=document.getElementById("settingsBackupText");
const hint=document.getElementById("settingsBackupHint");
const raw=ta.value.trim();
if(!raw){
hint.textContent="Вставьте текст резервной копии";
hint.style.color="#c62828";
return;
}
let parsed;
try{
parsed=JSON.parse(raw);
}catch(e){
hint.textContent="Не удалось прочитать текст — проверьте, что это резервная копия XCAR";
hint.style.color="#c62828";
return;
}
if(!parsed||typeof parsed!=="object"||!Array.isArray(parsed.cars)||!Array.isArray(parsed.history)){
hint.textContent="Этот текст не похож на резервную копию XCAR";
hint.style.color="#c62828";
return;
}
showConfirm({
title:"Импортировать резервную копию?",
message:"Текущие машины, история и настройки будут заменены данными из текста. Это действие нельзя отменить.",
confirmText:"Импортировать",
onConfirm:()=>{
cars=parsed.cars;
history=parsed.history;
if(parsed.settings&&typeof parsed.settings==="object"){
settings.billingMode=parsed.settings.billingMode==="persecond"?"persecond":"prepay";
// логин/пароль/сервер конкретного устройства из резервной копии НЕ восстанавливаем —
// это личные данные для входа именно на этом телефоне. А вот список сохранённых
// серверов (название+адрес) — это как раз то, что резервная копия должна переносить.
if(Array.isArray(parsed.settings.serverProfiles)){
settings.serverProfiles=parsed.settings.serverProfiles.filter(p=>p&&typeof p==="object"&&typeof p.id==="string"&&typeof p.url==="string").map(p=>({id:p.id,name:typeof p.name==="string"?p.name:"Сервер",url:p.url}));
settings.activeServerProfileId=typeof parsed.settings.activeServerProfileId==="string"?parsed.settings.activeServerProfileId:null;
}
// тема оформления и видимость стрелок навигации — тоже переносим,
// а вот остаток дней подписки НЕ трогаем (это привязано к конкретному
// устройству/аккаунту, а не к резервной копии данных)
if(typeof parsed.settings.theme==="string") settings.theme=parsed.settings.theme==="dark"?"dark":"light";
if(typeof parsed.settings.showNavArrows==="boolean") settings.showNavArrows=parsed.settings.showNavArrows;
if(parsed.settings.uiStyle==="new"||parsed.settings.uiStyle==="standard") settings.uiStyle=parsed.settings.uiStyle;
if(typeof parsed.settings.autoSyncEnabled==="boolean") settings.autoSyncEnabled=parsed.settings.autoSyncEnabled;
if(parsed.settings.autoSyncIntervalSec) settings.autoSyncIntervalSec=Math.min(59,Math.max(1,parseInt(parsed.settings.autoSyncIntervalSec,10)||30));
if(parsed.settings.fleetViewStyle==="tile") settings.fleetViewStyle="grid"; else if(parsed.settings.fleetViewStyle==="compact") settings.fleetViewStyle="list"; else if(parsed.settings.fleetViewStyle==="list") settings.fleetViewStyle="current"; else if(["grid","list","current","premium"].includes(parsed.settings.fleetViewStyle)) settings.fleetViewStyle=parsed.settings.fleetViewStyle;
}
selectedCarIdx=null;
saveCars();
saveHistory();
saveSettings();
renderCarManageList();
renderCarPickerList();
renderRentedList();
renderHistory();
updateCarPickerLabel();
renderBillingModeUI();
renderAccountUI();
renderServerProfiles();
applyTheme();
renderThemeUI();
renderUIStyle();
applyNavArrowsVisibility();
renderNavArrowsUI();
restartAutoSyncTimer();
renderAutoSyncUI();
hint.textContent="Импортировано ✓";
hint.style.color="#0a9a4a";
flashSuccess(document.getElementById("settingsImportBtn"));
vibrate([15,25,15]);
}
});
});

// ---------- звуковые сигналы (Web Audio API, без внешних файлов) ----------
function playBeep(freq,dur,vol){
try{
const Ctx=window.AudioContext||window.webkitAudioContext;
if(!Ctx) return;
const ctx=window.__xcarAudioCtx||(window.__xcarAudioCtx=new Ctx());
if(ctx.state==="suspended") ctx.resume().catch(()=>{});
const osc=ctx.createOscillator();
const gain=ctx.createGain();
osc.type="sine";
osc.frequency.value=freq||660;
gain.gain.setValueAtTime(vol||0.15, ctx.currentTime);
gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime+(dur||120)/1000);
osc.connect(gain);
gain.connect(ctx.destination);
osc.start();
osc.stop(ctx.currentTime+(dur||120)/1000+0.02);
}catch(e){}
}
function playSyncSound(success){
if(success){playBeep(660,80,0.14);setTimeout(()=>playBeep(920,140,0.14),90);}
else{playBeep(220,220,0.14);}
}

// ---------- аккаунт (логин/пароль/email/телефон) и синхронизация с сервером ----------
function apiUrl(path){
const base=(settings.account.serverUrl||"").trim().replace(/\/+$/,"");
return base+path;
}
function accountConfigured(){
const a=settings.account;
return !!(a.serverUrl&&a.serverUrl.trim()&&a.username&&a.username.trim()&&a.password&&a.password.length>=4);
}
function setAccountHint(text,isError){
const el=document.getElementById("accountHint");
if(!el) return;
el.textContent=text;
el.style.color=isError?"#c62828":"#0a9a4a";
}
function setAuthMode(mode){
document.getElementById("authTabLogin").classList.toggle("active",mode==="login");
document.getElementById("authTabRegister").classList.toggle("active",mode==="register");
document.getElementById("accountRegisterExtra").style.display=mode==="register"?"":"none";
document.getElementById("accountLoginBtn").style.display=mode==="register"?"none":"";
document.getElementById("accountRegisterBtn").style.display=mode==="register"?"":"none";
}
document.getElementById("authTabLogin").addEventListener("click",()=>setAuthMode("login"));
document.getElementById("authTabRegister").addEventListener("click",()=>setAuthMode("register"));
setAuthMode("login");
function renderAccountServerLink(){
const el=document.getElementById("accountServerLinkText");
if(!el) return;
const active=(settings.serverProfiles||[]).find(p=>p.id===settings.activeServerProfileId);
const url=(settings.account&&settings.account.serverUrl)||"";
if(active) el.textContent=`${active.name||"Сервер"} · ${active.url||""}`;
else if(url) el.textContent=url;
else el.textContent="Не выбран — откройте раздел «Серверы»";
}
function renderAccountUI(){
const a=settings.account;
const userEl=document.getElementById("accountUsername");
const passEl=document.getElementById("accountPassword");
const emailEl=document.getElementById("accountEmail");
const phoneEl=document.getElementById("accountPhone");
if(!userEl) return;
renderAccountServerLink();
if(document.activeElement!==userEl) userEl.value=a.username||"";
if(document.activeElement!==passEl) passEl.value=a.password||"";
if(document.activeElement!==emailEl) emailEl.value=a.email||"";
if(document.activeElement!==phoneEl) phoneEl.value=a.phone||"";
const authBlock=document.getElementById("accountAuthBlock");
const connectedRow=document.getElementById("accountConnectedBtnRow");
const deleteBtn=document.getElementById("accountDeleteBtn");
const statusLine=document.getElementById("accountStatusLine");
const pushRow=document.getElementById("pushToggleRow");
const pushCheck=document.getElementById("pushToggleCheck");
if(a.connected){
authBlock.style.display="none";
connectedRow.style.display="";
deleteBtn.style.display="";
if(pushRow) pushRow.style.display="";
if(pushCheck) pushCheck.checked=!!settings.pushEnabled;
let lastSync=0;
try{lastSync=parseInt(localStorage.getItem("xcarLastSyncAt")||"0",10)||0;}catch(e){}
const contactBits=[a.email,a.phone].filter(Boolean).join(" · ");
statusLine.textContent=(lastSync?`Вход выполнен как «${a.username}» · синхронизировано в ${new Date(lastSync).toLocaleTimeString("ru-RU",{hour:"2-digit",minute:"2-digit"})}`:`Вход выполнен как «${a.username}»`)+(contactBits?` · ${contactBits}`:"");
}else{
authBlock.style.display="";
connectedRow.style.display="none";
deleteBtn.style.display="none";
if(pushRow) pushRow.style.display="none";
statusLine.textContent="Работает без регистрации — данные хранятся только на этом устройстве";
}
}

// ---------- сохранённые серверы (Render / домашний / другие), с пингом и переключением ----------
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
const SERVER_TEMPLATES={
render:{name:"Render",placeholder:"https://xcar-server-xxxx.onrender.com"},
home:{name:"Домашний сервер (Ubuntu)",placeholder:"http://192.168.1.10:3000 или https://мой-домен.duckdns.org"},
custom:{name:"",placeholder:"https://..."}
};
let editingServerProfileId=null;
const pingResults={};
function genId(){return "s"+Date.now().toString(36)+Math.random().toString(36).slice(2,8);}
function renderServerProfiles(){
const wrap=document.getElementById("serverProfileList");
if(!wrap) return;
const profiles=settings.serverProfiles||[];
if(!profiles.length){
wrap.innerHTML=`<div class="serverEmptyHint">Пока нет сохранённых серверов — добавьте Render, домашний сервер или свой вариант ниже</div>`;
return;
}
wrap.innerHTML="";
profiles.forEach(p=>{
const isActive=settings.activeServerProfileId===p.id;
const pr=pingResults[p.id]||{status:"idle",text:""};
const item=document.createElement("div");
item.className="serverProfileItem"+(isActive?" active":"");
item.innerHTML=`<div class="serverProfileTop">`+
`<div class="serverProfileDot ${pr.status==="ok"?"ok":pr.status==="err"?"err":pr.status==="pending"?"pending":""}"></div>`+
`<div class="serverProfileInfo">`+
`<div class="serverProfileName">${escapeHtml(p.name||"Сервер")}</div>`+
`<div class="serverProfileUrl">${escapeHtml(p.url||"")}</div>`+
`</div>`+
`<button type="button" class="serverProfileUseBtn ${isActive?"active":""}" data-act="use">${isActive?"Активен":"Использовать"}</button>`+
`</div>`+
`<div class="serverProfileBottom">`+
`<div class="serverProfilePing">${escapeHtml(pr.text||"")}</div>`+
`<div class="serverProfileActions">`+
`<button type="button" class="serverProfileIconBtn" data-act="ping" title="Проверить">📶</button>`+
`<button type="button" class="serverProfileIconBtn" data-act="edit" title="Изменить">✎</button>`+
`<button type="button" class="serverProfileIconBtn" data-act="del" title="Удалить">🗑</button>`+
`</div>`+
`</div>`;
item.querySelector('[data-act="use"]').addEventListener("click",()=>activateServerProfile(p.id));
item.querySelector('[data-act="ping"]').addEventListener("click",()=>pingServerProfile(p.id));
item.querySelector('[data-act="edit"]').addEventListener("click",()=>openServerEdit(p.id));
item.querySelector('[data-act="del"]').addEventListener("click",()=>deleteServerProfile(p.id));
wrap.appendChild(item);
});
}
function activateServerProfile(id){
const p=(settings.serverProfiles||[]).find(x=>x.id===id);
if(!p) return;
settings.activeServerProfileId=id;
settings.account.serverUrl=p.url;
saveSettings();
renderAccountServerLink();
renderServerProfiles();
setAccountHint(`Выбран сервер «${p.name}»`,false);
vibrate(12);
}
async function pingServerProfile(id){
const p=(settings.serverProfiles||[]).find(x=>x.id===id);
if(!p) return;
pingResults[id]={status:"pending",text:"Проверка…"};
renderServerProfiles();
const url=(p.url||"").trim().replace(/\/+$/,"");
if(!url){pingResults[id]={status:"err",text:"Не указан адрес"};renderServerProfiles();return;}
const controller=(typeof AbortController!=="undefined")?new AbortController():null;
const timer=controller?setTimeout(()=>controller.abort(),5000):null;
const started=(typeof performance!=="undefined"&&performance.now)?performance.now():Date.now();
try{
const resp=await fetch(url+"/health",{signal:controller?controller.signal:undefined,cache:"no-store"});
if(timer) clearTimeout(timer);
const elapsed=Math.round(((typeof performance!=="undefined"&&performance.now)?performance.now():Date.now())-started);
if(resp.ok){pingResults[id]={status:"ok",text:`В сети · ${elapsed} мс`};}
else{pingResults[id]={status:"err",text:`Ошибка сервера (HTTP ${resp.status})`};}
}catch(e){
if(timer) clearTimeout(timer);
pingResults[id]={status:"err",text:e&&e.name==="AbortError"?"Не отвечает (таймаут)":"Недоступен"};
}
renderServerProfiles();
}
async function pingAllServerProfiles(){
const profiles=settings.serverProfiles||[];
if(!profiles.length){setAccountHint("Сначала добавьте сервер",true);return;}
await Promise.all(profiles.map(p=>pingServerProfile(p.id)));
}
function openServerEdit(id,tpl){
editingServerProfileId=id||null;
const box=document.getElementById("serverEditBox");
const nameEl=document.getElementById("serverEditName");
const urlEl=document.getElementById("serverEditUrl");
if(id){
const p=(settings.serverProfiles||[]).find(x=>x.id===id);
nameEl.value=p?p.name:"";
urlEl.value=p?p.url:"";
urlEl.placeholder="https://...";
}else{
const t=SERVER_TEMPLATES[tpl||"custom"];
nameEl.value=t.name;
urlEl.value="";
urlEl.placeholder=t.placeholder;
}
box.style.display="";
nameEl.focus();
}
function closeServerEdit(){
editingServerProfileId=null;
document.getElementById("serverEditBox").style.display="none";
document.getElementById("serverEditName").value="";
document.getElementById("serverEditUrl").value="";
}
function deleteServerProfile(id){
const p=(settings.serverProfiles||[]).find(x=>x.id===id);
if(!p) return;
showConfirm({
title:"Удалить сервер?",
message:`Профиль «${p.name}» будет удалён из списка. Сам сервер и данные на нём не затрагиваются.`,
confirmText:"Удалить",
onConfirm:()=>{
settings.serverProfiles=(settings.serverProfiles||[]).filter(x=>x.id!==id);
if(settings.activeServerProfileId===id) settings.activeServerProfileId=null;
delete pingResults[id];
saveSettings();
renderServerProfiles();
vibrate(15);
}
});
}
document.querySelectorAll(".serverQuickAddBtn").forEach(btn=>{
btn.addEventListener("click",()=>{
vibrate(10);
openServerEdit(null,btn.dataset.tpl);
});
});
document.getElementById("serverEditCancelBtn").addEventListener("click",closeServerEdit);
document.getElementById("serverEditSaveBtn").addEventListener("click",()=>{
const name=document.getElementById("serverEditName").value.trim()||"Сервер";
const url=document.getElementById("serverEditUrl").value.trim();
if(!url){setAccountHint("Укажите адрес сервера",true);vibrate(20);return;}
if(!settings.serverProfiles) settings.serverProfiles=[];
if(editingServerProfileId&&(settings.serverProfiles||[]).some(x=>x.id===editingServerProfileId)){
const p=settings.serverProfiles.find(x=>x.id===editingServerProfileId);
p.name=name;p.url=url;
}else{
const id=genId();
settings.serverProfiles.push({id,name,url});
editingServerProfileId=id;
}
saveSettings();
activateServerProfile(editingServerProfileId);
closeServerEdit();
renderServerProfiles();
setAccountHint("Сервер сохранён ✓",false);
vibrate([15,20,15]);
});
document.getElementById("serverPingAllBtn").addEventListener("click",()=>{vibrate(10);pingAllServerProfiles();});

async function doRegister(){
const a=settings.account;
if(!a.serverUrl||!a.serverUrl.trim()){setAccountHint("Укажите адрес сервера",true);vibrate(20);return;}
if(!a.username||!a.username.trim()){setAccountHint("Укажите логин",true);vibrate(20);return;}
if(!a.password||a.password.length<4){setAccountHint("Пароль должен быть не короче 4 символов",true);vibrate(20);return;}
setAccountHint("Регистрация…",false);
try{
// сразу создаём аккаунт НА СЕРВЕРЕ с текущими локальными данными одним запросом —
// это исключает гонку по времени с последующей отдельной синхронизацией
const resp=await fetch(apiUrl("/api/register"),{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({
username:a.username,
password:a.password,
email:a.email||"",
phone:a.phone||"",
payload:{cars:cars,history:history,settings:{billingMode:settings.billingMode}}
})
});
if(resp.status===409){
setAccountHint("Такой логин уже занят — нажмите «Вход» или выберите другой логин",true);
vibrate(20);
return;
}
if(!resp.ok){
const errData=await resp.json().catch(()=>({}));
throw new Error(errData.error||("HTTP "+resp.status));
}
const data=await resp.json();
settings.account.connected=true;
if(typeof data.subscriptionUntil==="number"&&data.subscriptionUntil>0) settings.subscriptionUntil=data.subscriptionUntil;
saveSettings();
try{localStorage.setItem("xcarLocalUpdatedAt", String(data.updatedAt||Date.now()));}catch(e){}
try{localStorage.setItem("xcarLastSyncAt", String(Date.now()));}catch(e){}
renderAccountUI();
renderSubscriptionUI();
vibrate([15,25,15]);
playSyncSound(true);
setAccountHint("Аккаунт создан ✓",false);
}catch(e){
vibrate([40,40,40]);
playSyncSound(false);
setAccountHint((e&&e.message&&!/^HTTP /.test(e.message))?e.message:"Не удалось зарегистрироваться — проверьте адрес сервера и соединение",true);
}
}
async function doLogin(){
const a=settings.account;
if(!a.serverUrl||!a.serverUrl.trim()){setAccountHint("Укажите адрес сервера",true);vibrate(20);return;}
if(!a.username||!a.username.trim()||!a.password){setAccountHint("Укажите логин и пароль",true);vibrate(20);return;}
setAccountHint("Вход…",false);
try{
const resp=await fetch(apiUrl("/api/login"),{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({username:a.username,password:a.password})
});
if(resp.status===404){
setAccountHint("Аккаунт не найден — нажмите «Регистрация»",true);
vibrate(20);
return;
}
if(resp.status===401){
setAccountHint("Неверный пароль",true);
vibrate(20);
return;
}
if(!resp.ok) throw new Error("HTTP "+resp.status);
const data=await resp.json();
const applyLogin=()=>{
if(data.payload&&Array.isArray(data.payload.cars)) cars=data.payload.cars;
if(data.payload&&Array.isArray(data.payload.history)) history=data.payload.history;
if(data.payload&&data.payload.settings&&typeof data.payload.settings==="object"){
settings.billingMode=data.payload.settings.billingMode==="persecond"?"persecond":"prepay";
}
if(typeof data.email==="string") settings.account.email=data.email;
if(typeof data.phone==="string") settings.account.phone=data.phone;
if(typeof data.subscriptionUntil==="number"&&data.subscriptionUntil>0) settings.subscriptionUntil=data.subscriptionUntil;
saveCars();
saveHistory();
try{localStorage.setItem("xcarLocalUpdatedAt", String(data.updatedAt||Date.now()));}catch(e){}
settings.account.connected=true;
saveSettings();
try{localStorage.setItem("xcarLastSyncAt", String(Date.now()));}catch(e){}
renderCarManageList();
renderCarPickerList();
renderRentedList();
renderHistory();
updateCarPickerLabel();
renderBillingModeUI();
renderAccountUI();
renderSubscriptionUI();
vibrate([15,25,15]);
playSyncSound(true);
setAccountHint("Вход выполнен ✓",false);
};
const hasLocalData=cars.length||history.length;
if(hasLocalData){
showConfirm({
title:"Войти в аккаунт?",
message:`Текущие машины, история и настройки на этом устройстве будут заменены данными аккаунта «${settings.account.username}». Это действие нельзя отменить.`,
confirmText:"Войти",
onConfirm:applyLogin
});
}else{
applyLogin();
}
}catch(e){
vibrate([40,40,40]);
playSyncSound(false);
setAccountHint("Не удалось войти — проверьте адрес сервера и соединение",true);
}
}
let syncInFlight=false;
function syncNow(opts){
opts=opts||{};
if(!accountConfigured()){
if(opts.manual){setAccountHint("Укажите логин и пароль",true);vibrate(20);}
return Promise.resolve();
}
if(syncInFlight) return Promise.resolve();
syncInFlight=true;
if(opts.manual) setAccountHint("Синхронизация…",false);
const controller=(typeof AbortController!=="undefined")?new AbortController():null;
const timer=controller?setTimeout(()=>controller.abort(),12000):null;
return fetch(apiUrl("/api/sync"),{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({
username:settings.account.username,
password:settings.account.password,
updatedAt:getLocalUpdatedAt(),
payload:{cars:cars,history:history,settings:{billingMode:settings.billingMode}}
}),
signal:controller?controller.signal:undefined
}).then(resp=>{
if(timer) clearTimeout(timer);
if(!resp.ok){const err=new Error("HTTP "+resp.status);err.status=resp.status;throw err;}
return resp.json();
}).then(data=>{
if(data&&data.payload){
if(Array.isArray(data.payload.cars)) cars=data.payload.cars;
if(Array.isArray(data.payload.history)) history=data.payload.history;
if(data.payload.settings&&typeof data.payload.settings==="object"){
settings.billingMode=data.payload.settings.billingMode==="persecond"?"persecond":"prepay";
}
saveCars();
saveHistory();
try{localStorage.setItem("xcarLocalUpdatedAt", String(data.updatedAt||Date.now()));}catch(e){}
renderCarManageList();
renderCarPickerList();
renderRentedList();
renderHistory();
updateCarPickerLabel();
renderBillingModeUI();
}
if(typeof data.subscriptionUntil==="number"&&data.subscriptionUntil>0) settings.subscriptionUntil=data.subscriptionUntil;
settings.account.connected=true;
saveSettings();
try{localStorage.setItem("xcarLastSyncAt", String(Date.now()));}catch(e){}
renderAccountUI();
renderSubscriptionUI();
if(opts.manual){vibrate([15,25,15]);playSyncSound(true);setAccountHint("Синхронизировано ✓",false);flashSuccess(document.getElementById("accountSyncNowBtn"));}
}).catch(err=>{
if(err&&(err.status===401||err.status===404)){
// сохранённые логин/пароль больше не подходят на сервере — выходим локально
settings.account.connected=false;
saveSettings();
renderAccountUI();
if(opts.manual){vibrate(20);setAccountHint("Сессия недействительна — войдите заново",true);}
return;
}
if(opts.manual){vibrate([40,40,40]);playSyncSound(false);setAccountHint("Не удалось синхронизировать — проверьте адрес сервера и соединение",true);}
}).finally(()=>{
syncInFlight=false;
});
}

// ---------- push-уведомления: если аренда оформлена/завершена на одном телефоне —
// на других телефонах, где выполнен вход в тот же аккаунт, приходит уведомление ----------
function urlBase64ToUint8Array(base64String){
const padding="=".repeat((4-base64String.length%4)%4);
const base64=(base64String+padding).replace(/-/g,"+").replace(/_/g,"/");
const rawData=atob(base64);
const outputArray=new Uint8Array(rawData.length);
for(let i=0;i<rawData.length;++i){outputArray[i]=rawData.charCodeAt(i);}
return outputArray;
}
function pushSupported(){
return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window;
}
async function subscribeToPush(){
if(!pushSupported()){setAccountHint("Этот браузер не поддерживает push-уведомления",true);return false;}
if(!accountConfigured()||!settings.account.connected){setAccountHint("Сначала войдите в аккаунт",true);return false;}
try{
let permission=Notification.permission;
if(permission==="default") permission=await Notification.requestPermission();
if(permission!=="granted"){setAccountHint("Уведомления запрещены в настройках браузера/телефона",true);return false;}
const reg=await navigator.serviceWorker.ready;
const keyResp=await fetch(apiUrl("/api/push/vapid-public-key"));
if(!keyResp.ok) throw new Error("HTTP "+keyResp.status);
const {publicKey}=await keyResp.json();
let sub=await reg.pushManager.getSubscription();
if(!sub){
sub=await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:urlBase64ToUint8Array(publicKey)});
}
const subJson=sub.toJSON();
const resp=await fetch(apiUrl("/api/push/subscribe"),{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({username:settings.account.username,password:settings.account.password,subscription:{endpoint:subJson.endpoint,keys:subJson.keys}})
});
if(!resp.ok) throw new Error("HTTP "+resp.status);
settings.pushEnabled=true;
settings.pushEndpoint=subJson.endpoint;
saveSettings();
setAccountHint("Push-уведомления включены ✓",false);
vibrate([15,25,15]);
return true;
}catch(e){
settings.pushEnabled=false;
saveSettings();
setAccountHint("Не удалось включить push-уведомления — проверьте разрешения и соединение",true);
return false;
}
}
async function unsubscribeFromPush(){
try{
if(pushSupported()){
const reg=await navigator.serviceWorker.ready;
const sub=await reg.pushManager.getSubscription();
if(sub){
if(accountConfigured()){
await fetch(apiUrl("/api/push/unsubscribe"),{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({username:settings.account.username,password:settings.account.password,endpoint:sub.endpoint})
}).catch(()=>{});
}
await sub.unsubscribe().catch(()=>{});
}
}
}catch(e){}
settings.pushEnabled=false;
settings.pushEndpoint="";
saveSettings();
}
document.getElementById("pushToggleCheck").addEventListener("change",async(e)=>{
const wantOn=e.target.checked;
if(wantOn){
const ok=await subscribeToPush();
if(!ok) e.target.checked=false;
}else{
e.target.checked=false;
await unsubscribeFromPush();
setAccountHint("Push-уведомления выключены",false);
vibrate(12);
}
});
// уведомляет ДРУГИЕ устройства этого же аккаунта о действии (не блокирует основной поток —
// если сервер недоступен, уведомление просто не дойдёт, это не мешает работе приложения)
function notifyOtherDevices(bodyText){
if(!accountConfigured()||!settings.account.connected) return;
fetch(apiUrl("/api/push/notify"),{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({username:settings.account.username,password:settings.account.password,title:"XCAR",body:bodyText,excludeEndpoint:settings.pushEndpoint||undefined})
}).catch(()=>{});
}


// ---------- заметки 1..8 ----------
const NOTES_KEY="xcarQuickNotes"; let quickNotes=[]; let editingNoteIdx=null; let noteClickTimer=null; let noteHoldTimer=null;
function loadQuickNotes(){try{const x=JSON.parse(localStorage.getItem(NOTES_KEY)||"[]");quickNotes=Array.from({length:8},(_,i)=>typeof x[i]==="string"?x[i]:"");}catch(e){quickNotes=Array(8).fill("");}}
function saveQuickNotes(){try{localStorage.setItem(NOTES_KEY,JSON.stringify(quickNotes));}catch(e){} renderNotesDot();}
function renderNotesDot(){const d=document.getElementById("notesDot");if(d)d.classList.toggle("on",quickNotes.some(Boolean));}
function openNotes(){renderNotesGrid();document.getElementById("notesModal").classList.add("open");}
function closeNotes(){document.getElementById("notesModal").classList.remove("open");document.getElementById("noteEditor").classList.remove("open");editingNoteIdx=null;}
function renderNotesGrid(){const g=document.getElementById("notesGrid");g.innerHTML="";quickNotes.forEach((txt,i)=>{const b=document.createElement("div");b.className="noteBox";b.style.setProperty("--note-i",i);b.innerHTML=`<div class="noteHoldProgress"></div><div class="noteNum">${i+1}</div><div class="noteText ${txt?"":"noteEmpty"}">${escapeHtml(txt||"Пусто")}</div>`;let hold=null;let moved=false;let held=false;let holdStarted=false;const progress=b.querySelector(".noteHoldProgress");const cancelHold=()=>{if(hold){clearTimeout(hold);hold=null;}if(progress)progress.classList.remove("active");b.classList.remove("noteHolding");};b.addEventListener("pointerdown",()=>{moved=false;held=false;holdStarted=true;b.classList.add("noteHolding");if(progress){progress.classList.remove("active");void progress.offsetWidth;progress.classList.add("active");}hold=setTimeout(()=>{held=true;hold=null;b.classList.remove("noteHolding");if(progress)progress.classList.remove("active");b.classList.add("noteClearing");vibrate([35,45,35]);playBeep(620,90,0.12);setTimeout(()=>playBeep(880,130,0.10),95);setTimeout(()=>{quickNotes[i]="";saveQuickNotes();renderNotesGrid();},430);},2500);});b.addEventListener("pointermove",e=>{if(Math.abs(e.movementX)>10||Math.abs(e.movementY)>10){moved=true;cancelHold();}});b.addEventListener("pointercancel",cancelHold);b.addEventListener("pointerleave",()=>{if(!held)cancelHold();});b.addEventListener("pointerup",()=>{if(held){held=false;return;}cancelHold();if(moved||!holdStarted)return;editingNoteIdx=i;const ta=document.getElementById("noteEditorText");ta.value=quickNotes[i];ta.readOnly=false;document.getElementById("noteSaveBtn").style.display="block";document.getElementById("noteEditor").classList.add("open");b.classList.add("notePulse");setTimeout(()=>b.classList.remove("notePulse"),550);setTimeout(()=>ta.focus(),40);holdStarted=false;});g.appendChild(b);});}
loadQuickNotes();renderNotesDot();
document.getElementById("notesCloseBtn").addEventListener("click",closeNotes);
document.getElementById("notesModal").addEventListener("click",e=>{if(e.target.id==="notesModal")closeNotes();});
document.getElementById("noteCancelBtn").addEventListener("click",()=>{document.getElementById("noteEditorText").readOnly=false;document.getElementById("noteSaveBtn").style.display="block";document.getElementById("noteEditor").classList.remove("open");});
document.getElementById("noteSaveBtn").addEventListener("click",()=>{if(editingNoteIdx===null)return;quickNotes[editingNoteIdx]=document.getElementById("noteEditorText").value.trim();saveQuickNotes();renderNotesGrid();document.getElementById("noteEditor").classList.remove("open");});
