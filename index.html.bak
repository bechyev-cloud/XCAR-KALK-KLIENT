<table>
<thead>
<tr><th colspan="2">Аренда Авто <span style="color:#ff0000;">X</span><span style="color:#ffffff;">CAR</span></th></tr>
<tr><th colspan="2" id="startInfoRow" style="background:#12315a;font-weight:500;font-size:12px;letter-spacing:.3px;padding:8px 12px;"></th></tr>
</thead>
<tbody id="tableBody"></tbody>
</table>
