 --xc-bg:#f4f6f8;--xc-surface:#ffffff;--xc-surface2:#f8fafb;--xc-ink:#13202d;--xc-muted:#748091;
 --xc-line:#e6ebf0;--xc-green:#18a957;--xc-green2:#0f8f49;--xc-blue:#173b67;--xc-shadow:0 12px 34px rgba(18,32,47,.08);
