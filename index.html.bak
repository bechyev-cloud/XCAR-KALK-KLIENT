html[data-theme="dark"] .card{background:rgba(14,23,36,.94);border-color:#26364b;box-shadow:0 22px 65px rgba(0,0,0,.35)}
html[data-theme="dark"] .page2Drawer{background:#0b1420}.page2Content{background:transparent!important}html[data-theme="dark"] .page2Tabs{background:#0b1420}
html[data-theme="dark"] .fleetViewSwitch{background:#111c2b;border-color:#26364b} html[data-theme="dark"] .fleetViewOpt{color:#8392a5}html[data-theme="dark"] .fleetViewOpt.active{background:#1a2738;color:#b9d1e8}
html[data-theme="dark"] .carManageCard{background:linear-gradient(145deg,#121f2f,#0f1a28);border-color:#26384d;box-shadow:0 10px 28px rgba(0,0,0,.24)}
html[data-theme="dark"] .carPhotoAvatar{background:linear-gradient(145deg,#1a2a3c,#152235);border-color:#304257}html[data-theme="dark"] .carEditName{color:#eef4f8!important}html[data-theme="dark"] .carEditPrice{color:#9cc1e8!important}html[data-theme="dark"] .carStatusRow{border-color:#24364a}html[data-theme="dark"] .rentSwitchLabel{color:#aebccc}html[data-theme="dark"] .carDeleteBtn{background:#321b20!important;border-color:#593039!important;color:#ff9da5!important}
html[data-theme="dark"] .cardViewMenuCard{background:#101b29;border-color:#2b3d52}html[data-theme="dark"] .cardViewMenuBtn{background:#172535;border-color:#2a3b50;color:#dbe6ef}html[data-theme="dark"] .cardViewMenuBtn.active{background:#103623;border-color:#2b8f5a;color:#a9eac6}

/* Fleet view chooser: the header button controls only the automobile card layout. */
.cardViewMenuTitle{letter-spacing:-.2px;}
.cardViewMenuBtn{position:relative;min-height:84px;}
.cardViewMenuBtn.active::after{content:"✓";position:absolute;top:8px;right:10px;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:900;background:#18a765;color:#fff;}

/* ===================== XCAR PREMIUM UI MODE ===================== */
:root{--xc-accent:#17b968;--xc-accent2:#0d8f52;--xc-ink:#142235;--xc-muted:#718096;--xc-line:#e5ebf0;--xc-surface:#ffffff;--xc-soft:#f4f7f8;--xc-ease:cubic-bezier(.22,1,.36,1);--xc-fast:.18s;--xc-mid:.34s;}
.uiStyleRow{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.uiStyleOpt{width:auto;margin:0;padding:12px;border:1.5px solid var(--xc-line);background:#f7f9fa;border-radius:18px;color:var(--xc-ink);cursor:pointer;font-family:inherit;transition:transform .25s var(--xc-ease),border-color .25s var(--xc-ease),box-shadow .25s var(--xc-ease),background .25s var(--xc-ease);}
.uiStyleOpt:active{transform:scale(.97)}
.uiStyleOpt.active{border-color:#7dd8a8;background:#effbf4;box-shadow:0 10px 28px rgba(23,185,104,.13);}
.uiStylePreview{height:58px;border-radius:13px;padding:8px;box-sizing:border-box;position:relative;overflow:hidden;margin-bottom:9px;background:#fff;border:1px solid #e6ebef;}
.uiStylePreview span,.uiStylePreview i,.uiStylePreview b{display:block;position:absolute;border-radius:6px;font-style:normal;}
.standardPreview span{left:8px;right:8px;top:8px;height:9px;background:#dfe6ed}.standardPreview i{left:8px;top:23px;width:45%;height:25px;background:#edf1f5}.standardPreview b{right:8px;top:23px;width:38%;height:25px;background:#f4f6f8}
.newPreview{background:linear-gradient(145deg,#14283b,#0e1d2d);border-color:#243e55}.newPreview span{left:8px;right:8px;top:8px;height:9px;background:linear-gradient(90deg,#25d67f,#a2f3c8);opacity:.9}.newPreview i{left:8px;top:23px;width:58%;height:25px;background:linear-gradient(135deg,#284b5c,#1a3445)}.newPreview b{right:8px;top:23px;width:25%;height:25px;background:#19bd6a;box-shadow:0 0 18px rgba(25,189,106,.35)}
.uiStyleName{font-size:12.5px;font-weight:900}.uiStyleDesc{font-size:10px;color:#8995a3;font-weight:700;margin-top:3px}.uiStyleOpt.active .uiStyleName{color:#0b9850}
html[data-ui-style="new"] body{background:radial-gradient(circle at 50% -10%,#e9f7ef 0,#f5f7f8 35%,#e9eef1 100%);}
html[data-ui-style="new"] .card{max-width:500px;border-radius:30px;padding:18px 16px 20px;background:rgba(255,255,255,.94);box-shadow:0 28px 80px rgba(20,39,57,.15),0 2px 10px rgba(20,39,57,.05);border:1px solid rgba(255,255,255,.9);}
html[data-ui-style="new"] .logo{font-size:30px;letter-spacing:-.7px}.logo .x{color:#e53935}.logo .f{color:#18334b}
html[data-ui-style="new"] .topBar{margin-bottom:14px}.topBar:after{content:"";position:absolute;left:48px;right:48px;bottom:-9px;height:1px;background:linear-gradient(90deg,transparent,#dce6e3,transparent);}
html[data-ui-style="new"] .navBtn,html[data-ui-style="new"] .gearBtn{background:linear-gradient(145deg,#fff,#edf3f0);border:1px solid #e3ebe7;box-shadow:0 8px 20px rgba(24,54,43,.08);}
html[data-ui-style="new"] input,html[data-ui-style="new"] select,html[data-ui-style="new"] .carPickerBtn{background:#f7faf9;border-color:#e2eae6;border-radius:16px;box-shadow:inset 0 1px 0 rgba(255,255,255,.8);transition:border-color .25s var(--xc-ease),box-shadow .25s var(--xc-ease),transform .25s var(--xc-ease);}
html[data-ui-style="new"] input:focus,html[data-ui-style="new"] select:focus{outline:none;border-color:#70d5a0;box-shadow:0 0 0 4px rgba(23,185,104,.10);}
html[data-ui-style="new"] button{border-radius:16px;transition:transform .25s var(--xc-ease),box-shadow .25s var(--xc-ease),filter .25s var(--xc-ease);}
html[data-ui-style="new"] button:active{transform:translateY(1px) scale(.985);}
html[data-ui-style="new"] .b1{background:linear-gradient(135deg,#16364a,#0e293a);box-shadow:0 10px 24px rgba(16,46,62,.16)}
html[data-ui-style="new"] .b7{background:linear-gradient(135deg,#20c875,#0da55b);box-shadow:0 10px 24px rgba(13,165,91,.20)}
html[data-ui-style="new"] .b3{background:linear-gradient(135deg,#637186,#475568);box-shadow:0 10px 24px rgba(71,85,104,.15)}
html[data-ui-style="new"] .result{background:linear-gradient(145deg,#f2faf5,#eef6f2);border:1px solid #dcece3;box-shadow:0 12px 30px rgba(23,185,104,.07);}
html[data-ui-style="new"] .page2Drawer{background:linear-gradient(180deg,#fbfdfc,#f1f5f4);box-shadow:0 -25px 70px rgba(17,38,32,.20);border-top:1px solid rgba(255,255,255,.95)}
html[data-ui-style="new"] .page2Header{background:linear-gradient(135deg,#173b4c,#102b3b);box-shadow:0 10px 30px rgba(16,43,59,.18)}
html[data-ui-style="new"] .page2Title{letter-spacing:-.3px}.page2HeaderBtns .page2QuickBtn,.page2HeaderBtns .notifyBellBtn,.page2HeaderBtns .carAddTopBtn{transition:transform .3s var(--xc-ease),box-shadow .3s var(--xc-ease),background .3s var(--xc-ease);}
html[data-ui-style="new"] .page2HeaderBtns .page2QuickBtn,html[data-ui-style="new"] .page2HeaderBtns .notifyBellBtn{background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.18);box-shadow:0 6px 18px rgba(0,0,0,.10);}
html[data-ui-style="new"] .page2HeaderBtns .carAddTopBtn{background:linear-gradient(135deg,#28d27e,#0fa45b);box-shadow:0 10px 24px rgba(15,164,91,.32);}
html[data-ui-style="new"] .page2Tabs{background:#e9efed;border:1px solid #dde7e2;padding:4px;border-radius:18px;box-shadow:inset 0 1px 2px rgba(20,45,35,.05)}
html[data-ui-style="new"] .page2Tab{border-radius:14px;color:#718079;transition:all .32s var(--xc-ease)}html[data-ui-style="new"] .page2Tab.active{background:#fff;color:#0b8f4d;box-shadow:0 7px 18px rgba(22,59,45,.10)}
html[data-ui-style="new"] .fleetViewSwitch{background:#e9efed;border:1px solid #dfe8e3;border-radius:17px;padding:4px;box-shadow:inset 0 1px 2px rgba(20,45,35,.04)}
html[data-ui-style="new"] .fleetViewOpt{border-radius:13px;color:#718079;transition:all .32s var(--xc-ease)}html[data-ui-style="new"] .fleetViewOpt.active{background:#fff;color:#0b9850;box-shadow:0 7px 18px rgba(22,59,45,.10)}
html[data-ui-style="new"] .carManageCard{border:1px solid #e1e9e5;background:rgba(255,255,255,.96);border-radius:22px;box-shadow:0 12px 30px rgba(23,48,39,.08);transition:transform .35s var(--xc-ease),box-shadow .35s var(--xc-ease),border-color .35s var(--xc-ease);overflow:hidden;}
html[data-ui-style="new"] .carManageCard:hover{transform:translateY(-2px);box-shadow:0 18px 40px rgba(23,48,39,.12);border-color:#cfe3d8}
html[data-ui-style="new"] .carPhotoAvatar{border-radius:17px;background:linear-gradient(145deg,#f1f5f3,#e7eeeb);border-color:#dbe5e0;box-shadow:inset 0 1px 0 #fff;}
html[data-ui-style="new"] .carEditName,html[data-ui-style="new"] .carEditPrice{background:#f7faf9;border-color:#e4ebe7;font-weight:800}
html[data-ui-style="new"] .rentSwitchTrack{box-shadow:inset 0 2px 5px rgba(0,0,0,.12);transition:background .28s var(--xc-ease),box-shadow .28s var(--xc-ease)}
html[data-ui-style="new"] .rentSwitch input:checked + .rentSwitchLabel + .rentSwitchTrack{background:linear-gradient(135deg,#23ce7a,#0fa55b);box-shadow:0 4px 14px rgba(15,165,91,.24)}
html[data-ui-style="new"] .rentSwitchThumb{transition:transform .32s var(--xc-ease),box-shadow .32s var(--xc-ease)}
html[data-ui-style="new"] .carDeleteBtn{background:#fff4f3;border-color:#f1d6d2;transition:all .25s var(--xc-ease)}html[data-ui-style="new"] .carDeleteBtn:active{background:#ffe7e3}
html[data-ui-style="new"] .statusBadge{box-shadow:0 6px 15px rgba(0,0,0,.06);letter-spacing:.2px}
html[data-ui-style="new"] .modalOverlay{background:rgba(10,27,22,.42);backdrop-filter:blur(12px)}
html[data-ui-style="new"] .modalCard{border-radius:28px;border:1px solid rgba(255,255,255,.9);box-shadow:0 30px 90px rgba(12,33,26,.22);animation:xcModalIn .42s var(--xc-ease)}
@keyframes xcModalIn{from{opacity:0;transform:translateY(18px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
html[data-ui-style="new"] .settingsFolder{border-radius:20px;border-color:#e0e9e4;background:linear-gradient(145deg,#fbfdfc,#f4f7f6);box-shadow:0 7px 20px rgba(21,51,40,.045);}
html[data-ui-style="new"] .settingsFolder.open{border-color:#b9e5ca;box-shadow:0 12px 28px rgba(23,185,104,.08)}
html[data-ui-style="new"] .settingsFolderIconBadge{background:linear-gradient(135deg,#e9faf1,#d7f4e4);box-shadow:0 7px 15px rgba(23,185,104,.08)}
html[data-ui-style="new"] .cardViewMenuCard{border-radius:28px;background:rgba(255,255,255,.97);box-shadow:0 30px 90px rgba(11,31,23,.24)}
html[data-ui-style="new"] .cardViewMenuBtn{border-radius:20px;transition:transform .3s var(--xc-ease),box-shadow .3s var(--xc-ease),border-color .3s var(--xc-ease)}html[data-ui-style="new"] .cardViewMenuBtn.active{background:#effbf4;border-color:#80d8a8;box-shadow:0 10px 25px rgba(23,185,104,.12)}
html[data-ui-style="new"] .carHoldOverlay{background:rgba(239,251,244,.52);backdrop-filter:blur(2px)}
html[data-ui-style="new"] .carHoldLabel{background:rgba(16,48,37,.90);box-shadow:0 12px 30px rgba(10,40,28,.25)}
html[data-ui-style="new"] .carHoldOverlayFill{background:linear-gradient(90deg,rgba(23,185,104,.10),rgba(23,185,104,.38))!important}
html[data-ui-style="new"] .historyItem,html[data-ui-style="new"] .notifyItem,html[data-ui-style="new"] .contactItem{border:1px solid #e2eae6;box-shadow:0 8px 22px rgba(22,50,39,.05);transition:transform .3s var(--xc-ease),box-shadow .3s var(--xc-ease)}
html[data-ui-style="new"] .historyItem:active,html[data-ui-style="new"] .notifyItem:active{transform:scale(.985)}
html[data-ui-style="new"] .page2Hint{color:#7c8b84}
html[data-ui-style="new"] .updateAppBtn{color:#0b9850;border-color:#bfe7ce}
html[data-ui-style="new"] .serverRefreshBtn .serverRefreshIcon{transition:transform .6s var(--xc-ease)}html[data-ui-style="new"] .serverRefreshBtn.busy .serverRefreshIcon{animation:xcSpin .7s linear infinite}@keyframes xcSpin{to{transform:rotate(360deg)}}
html[data-ui-style="new"] .page2QuickBtn:hover,html[data-ui-style="new"] .notifyBellBtn:hover,html[data-ui-style="new"] .carAddTopBtn:hover{transform:translateY(-2px)}
html[data-ui-style="new"] .carListWrap.viewTile .carManageCard{min-height:250px}
html[data-ui-style="new"] .carListWrap.viewTile .carPhotoAvatar{height:116px;width:100%;border-radius:18px}
html[data-ui-style="new"] .carListWrap.viewTile .carPhotoAvatar img{width:100%;height:100%;object-fit:cover}
html[data-ui-style="new"] .carListWrap.viewTile .carManageCard{padding:12px}
html[data-ui-style="new"] .carListWrap.viewTile .carDeleteBtn{top:12px;right:12px}
html[data-ui-style="new"] .carListWrap.viewTile .rentSwitch{margin-top:10px}
html[data-ui-style="new"] .carListWrap.viewTile .carEditName,html[data-ui-style="new"] .carListWrap.viewTile .carEditPrice{border-radius:13px}
html[data-ui-style="new"] .carListWrap.viewTile .carEditName{font-size:14px;font-weight:900}
html[data-ui-style="new"] .carListWrap.viewTile .carEditPrice{font-size:13px}
html[data-ui-style="new"] .carListWrap.viewTile .carRentSince{font-size:10px;color:#82918a}
html[data-ui-style="new"] .carListWrap.viewTile .carStatusRow{margin-top:9px}
html[data-ui-style="new"] .page2Panel{animation:xcPanelIn .35s var(--xc-ease)}
@keyframes xcPanelIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
html[data-ui-style="new"] .page2Panel:not(.active){animation:none}
html[data-ui-style="new"] .settingsOpenBtn{border-radius:16px;transition:all .28s var(--xc-ease)}html[data-ui-style="new"] .settingsOpenBtn:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(22,55,42,.07)}
html[data-ui-style="new"] .uiStyleOpt.active{box-shadow:0 12px 28px rgba(23,185,104,.13)}
html[data-theme="dark"][data-ui-style="new"] body{background:radial-gradient(circle at 50% -10%,#173125 0,#0b1218 42%,#070b10 100%)}
html[data-theme="dark"][data-ui-style="new"] .card{background:rgba(12,20,27,.96);border-color:#26362f;box-shadow:0 30px 90px rgba(0,0,0,.55)}
html[data-theme="dark"][data-ui-style="new"] .topBar:after{background:linear-gradient(90deg,transparent,#294136,transparent)}
html[data-theme="dark"][data-ui-style="new"] input,html[data-theme="dark"][data-ui-style="new"] select,html[data-theme="dark"][data-ui-style="new"] .carPickerBtn{background:#111b18;border-color:#2a3c34;color:#e8f1ed}
html[data-theme="dark"][data-ui-style="new"] .page2Drawer{background:linear-gradient(180deg,#0e1815,#09110f);border-color:#263a31}
html[data-theme="dark"][data-ui-style="new"] .page2Tabs,html[data-theme="dark"][data-ui-style="new"] .fleetViewSwitch{background:#111b18;border-color:#263a31}
html[data-theme="dark"][data-ui-style="new"] .page2Tab.active,html[data-theme="dark"][data-ui-style="new"] .fleetViewOpt.active{background:#1a2a23;color:#71e2a3}
html[data-theme="dark"][data-ui-style="new"] .carManageCard{background:#101a17;border-color:#293b33;box-shadow:0 16px 35px rgba(0,0,0,.26)}
html[data-theme="dark"][data-ui-style="new"] .carEditName,html[data-theme="dark"][data-ui-style="new"] .carEditPrice{background:#0d1512;border-color:#293b33;color:#eaf3ef}
html[data-theme="dark"][data-ui-style="new"] .settingsFolder{background:linear-gradient(145deg,#101a17,#0d1512);border-color:#293b33}
html[data-theme="dark"][data-ui-style="new"] .uiStyleOpt{background:#111b18;border-color:#293b33;color:#e8f1ed}.uiStyleOpt.active{color:#e8f1ed}
html[data-theme="dark"][data-ui-style="new"] .standardPreview{background:#17211f;border-color:#2a3934}.standardPreview span{background:#56635f}.standardPreview i{background:#34413d}.standardPreview b{background:#28342f}
html[data-theme="dark"][data-ui-style="new"] .newPreview{border-color:#355244}


/* XCAR HEADER CONTROLS — unified premium design */
html[data-ui-style="new"] .page2Header{
  background:linear-gradient(135deg,#102f50 0%,#123d60 52%,#145b55 100%);
  padding:calc(24px + env(safe-area-inset-top)) 18px 18px;
  box-shadow:0 14px 34px rgba(8,35,55,.20);
}
html[data-ui-style="new"] .page2HeaderTop{align-items:center;gap:14px}
html[data-ui-style="new"] .page2Title{font-size:22px;font-weight:900;letter-spacing:-.55px;text-shadow:0 2px 12px rgba(0,0,0,.14)}
html[data-ui-style="new"] .page2Subtitle{margin-top:3px;font-size:11.5px;font-weight:700;color:rgba(255,255,255,.70)}
html[data-ui-style="new"] .page2HeaderBtns{gap:8px;padding:5px;border-radius:18px;background:rgba(5,23,38,.20);border:1px solid rgba(255,255,255,.10);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:inset 0 1px 0 rgba(255,255,255,.08)}
html[data-ui-style="new"] .page2HeaderBtns > button{
  width:40px;height:40px;min-width:40px;margin:0;border-radius:13px;border:1px solid rgba(255,255,255,.18);
  display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;
  font-family:inherit;font-weight:900;cursor:pointer;-webkit-tap-highlight-color:transparent;
  transition:transform .28s cubic-bezier(.2,.8,.2,1),box-shadow .28s ease,background .28s ease,filter .28s ease;
}
html[data-ui-style="new"] .page2HeaderBtns > button::before{content:"";position:absolute;inset:1px;border-radius:12px;background:linear-gradient(135deg,rgba(255,255,255,.16),rgba(255,255,255,0));pointer-events:none}
html[data-ui-style="new"] .page2HeaderBtns > button:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(0,0,0,.18);filter:brightness(1.04)}
html[data-ui-style="new"] .page2HeaderBtns > button:active{transform:scale(.91);box-shadow:0 4px 10px rgba(0,0,0,.12);filter:brightness(.98)}
html[data-ui-style="new"] .page2HeaderBtns .carAddTopBtn{
  width:40px;height:40px;border-radius:13px;background:linear-gradient(145deg,#34e18a,#0cad61);color:#fff;border-color:rgba(255,255,255,.24);
  font-size:23px;box-shadow:0 8px 20px rgba(15,173,97,.34),inset 0 1px 0 rgba(255,255,255,.25)
}
html[data-ui-style="new"] .page2HeaderBtns .page2QuickBtn,
html[data-ui-style="new"] .page2HeaderBtns .notifyBellBtn{
  background:linear-gradient(145deg,rgba(255,255,255,.95),rgba(231,240,247,.86));color:#18324a;
  border-color:rgba(255,255,255,.72);box-shadow:0 7px 18px rgba(0,20,40,.16),inset 0 1px 0 #fff;
  font-size:18px;
}
html[data-ui-style="new"] .page2HeaderBtns .notifyBellBtn{font-size:17px}
html[data-ui-style="new"] .page2HeaderBtns .notesTopBtn{background:linear-gradient(145deg,#f5f9fc,#dce7ef)}
html[data-ui-style="new"] .page2HeaderBtns .page2CloseBtn{
  background:rgba(255,255,255,.11);color:rgba(255,255,255,.92);border-color:rgba(255,255,255,.22);font-size:17px;box-shadow:0 7px 18px rgba(0,0,0,.13)
}
html[data-ui-style="new"] .page2HeaderBtns .serverRefreshBtn.busy{background:linear-gradient(145deg,#dff4ff,#c8e8f6)}
html[data-ui-style="new"] .page2HeaderBtns .notesDot{width:7px;height:7px;border-radius:50%;background:#16c784;box-shadow:0 0 0 3px rgba(22,199,132,.15);position:absolute;top:6px;right:6px}
html[data-ui-style="new"] .page2HeaderBtns .notifyBellBadge{box-shadow:0 0 0 2px #143552,0 3px 8px rgba(0,0,0,.2);top:3px;right:3px}
html[data-ui-style="new"] .page2HeaderBtns .serverRefreshIcon{font-size:21px;line-height:1}
html[data-ui-style="new"] .page2HeaderBtns .notifyBellIcon{font-size:18px;line-height:1}
html[data-theme="dark"][data-ui-style="new"] .page2Header{
  background:linear-gradient(135deg,#0b1b2a 0%,#102d42 52%,#10483f 100%);box-shadow:0 16px 40px rgba(0,0,0,.45)
}
html[data-theme="dark"][data-ui-style="new"] .page2HeaderBtns{background:rgba(0,0,0,.25);border-color:rgba(255,255,255,.08)}
html[data-theme="dark"][data-ui-style="new"] .page2HeaderBtns .page2QuickBtn,
html[data-theme="dark"][data-ui-style="new"] .page2HeaderBtns .notifyBellBtn{background:linear-gradient(145deg,#22384a,#182b3b);color:#e8f3fa;border-color:#355063;box-shadow:0 8px 20px rgba(0,0,0,.34),inset 0 1px 0 rgba(255,255,255,.08)}
html[data-theme="dark"][data-ui-style="new"] .page2HeaderBtns .notesTopBtn{background:linear-gradient(145deg,#294052,#1b3040)}
html[data-theme="dark"][data-ui-style="new"] .page2HeaderBtns .page2CloseBtn{background:rgba(255,255,255,.08);color:#f0f5f8;border-color:rgba(255,255,255,.14)}


/* ===== NOTES SIGNATURE DESIGN ===== */
:root{--notes-green:#18c96a;--notes-green2:#0aa653;--notes-ink:#14253a;--notes-muted:#718096;}
.notesModalGrid{grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:18px;perspective:900px;}
.noteBox{min-height:112px;border:1px solid rgba(35,52,75,.10);background:linear-gradient(145deg,#ffffff 0%,#f5f8fb 100%);border-radius:20px;padding:13px;box-sizing:border-box;cursor:pointer;position:relative;overflow:hidden;isolation:isolate;box-shadow:0 8px 22px rgba(20,35,55,.08),inset 0 1px 0 rgba(255,255,255,.95);transition:transform .28s cubic-bezier(.22,1,.36,1),box-shadow .28s,border-color .28s,background .28s;}
.noteBox:before{content:"";position:absolute;inset:-35% auto auto -35%;width:90px;height:90px;border-radius:50%;background:radial-gradient(circle,rgba(24,201,106,.22),rgba(24,201,106,0) 70%);z-index:-1;transition:transform .45s ease;}
.noteBox:after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:linear-gradient(90deg,#18c96a,#7af0ad);transform:scaleX(0);transform-origin:left;transition:transform .3s ease;}.noteHoldProgress{position:absolute;left:0;top:0;bottom:0;width:0;background:linear-gradient(90deg,rgba(24,201,106,.05),rgba(24,201,106,.22));pointer-events:none;border-radius:inherit;z-index:0;overflow:hidden;opacity:0}.noteHoldProgress:after{content:"";position:absolute;right:-22px;top:0;width:22px;height:100%;background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.72),rgba(255,255,255,0));filter:blur(2px)}.noteHoldProgress.active{opacity:1;animation:noteHoldFill 2.5s linear forwards}.noteBox.noteHolding{transform:scale(.985);box-shadow:0 12px 30px rgba(24,201,106,.18),0 0 0 2px rgba(24,201,106,.12)}.noteBox>*:not(.noteHoldProgress){position:relative;z-index:1}@keyframes noteHoldFill{from{width:0}to{width:100%}}
.noteBox:hover{transform:translateY(-5px) rotateX(1deg);box-shadow:0 16px 34px rgba(20,35,55,.14),0 0 0 1px rgba(24,201,106,.08);border-color:rgba(24,201,106,.35);}
.noteBox:hover:before{transform:translate(28px,20px) scale(1.35);}
.noteBox:hover:after{transform:scaleX(1);}
.noteBox:active{transform:scale(.96) translateY(1px);box-shadow:0 6px 14px rgba(20,35,55,.12);}
.noteNum{display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:10px;background:linear-gradient(145deg,#1dd475,#0ba955);color:#fff;font-size:12px;font-weight:950;box-shadow:0 6px 14px rgba(24,201,106,.25);}
.noteText{font-size:12px;font-weight:750;color:#172337;margin-top:12px;white-space:pre-wrap;word-break:break-word;max-height:48px;overflow:hidden;line-height:1.35;}
.noteEmpty{color:#9aa6b5!important;font-weight:650;}
.noteBox.notePulse{animation:notePulse .52s cubic-bezier(.34,1.56,.64,1);}
.noteBox.noteClearing{animation:noteClear .48s ease forwards;}
@keyframes notePulse{0%{transform:scale(.94);opacity:.7}55%{transform:scale(1.035);box-shadow:0 0 0 7px rgba(24,201,106,.12),0 18px 40px rgba(24,201,106,.20)}100%{transform:scale(1);opacity:1}}
@keyframes noteClear{0%{transform:scale(1);opacity:1}35%{transform:scale(.94) rotate(-2deg);filter:blur(.2px)}100%{transform:scale(.72) rotate(4deg);opacity:0;filter:blur(5px)}}
.notesModalGrid .noteBox{animation:noteIn .42s cubic-bezier(.22,1,.36,1) both;animation-delay:calc(var(--note-i,0) * 45ms);}
@keyframes noteIn{from{opacity:0;transform:translateY(14px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
#notesModal .modalCard{overflow:hidden;background:linear-gradient(145deg,rgba(255,255,255,.98),rgba(245,249,253,.98));border:1px solid rgba(255,255,255,.9);box-shadow:0 30px 90px rgba(8,22,40,.30),0 0 0 1px rgba(24,201,106,.05);}
#notesModal .modalCard:before{content:"";position:absolute;width:180px;height:180px;right:-70px;top:-80px;border-radius:50%;background:radial-gradient(circle,rgba(24,201,106,.16),rgba(24,201,106,0) 70%);pointer-events:none;}
#notesModal .modalTitle{font-size:22px;letter-spacing:-.4px;display:flex;align-items:center;gap:8px;}
#notesModal .modalSub{color:#7a8798;line-height:1.45;}
.noteEditor{background:rgba(255,255,255,.76);border:1px solid #e1e8ef;border-radius:20px;padding:12px;box-shadow:0 14px 30px rgba(15,35,60,.09);animation:editorIn .28s cubic-bezier(.22,1,.36,1);}
@keyframes editorIn{from{opacity:0;transform:translateY(10px) scale(.98)}to{opacity:1;transform:none}}
.noteEditor textarea{min-height:135px;border:1px solid #dce5ee;background:#fbfcfe;border-radius:15px;padding:14px;outline:none;transition:border-color .2s,box-shadow .2s,background .2s;}
.noteEditor textarea:focus{border-color:rgba(24,201,106,.7);box-shadow:0 0 0 4px rgba(24,201,106,.11);background:#fff;}
.noteEditorRow button{min-height:44px;border-radius:14px;transition:transform .2s,box-shadow .2s,filter .2s;}
.noteEditorRow button:hover{transform:translateY(-1px);}.noteEditorRow button:active{transform:scale(.97);}
.noteSave{background:linear-gradient(135deg,#1dd475,#0aa653)!important;box-shadow:0 9px 20px rgba(24,201,106,.24);}
.noteCancel{border:1px solid #dfe6ee!important;}
@media(max-width:520px){.notesModalGrid{grid-template-columns:repeat(2,1fr);}.noteBox{min-height:105px;}}
html[data-theme="dark"] #notesModal .modalCard{background:linear-gradient(145deg,#111d2d,#0c1624);border-color:#26364c;box-shadow:0 30px 90px rgba(0,0,0,.65),0 0 0 1px rgba(24,201,106,.05);}
html[data-theme="dark"] .noteBox{background:linear-gradient(145deg,#172437,#101b2b);border-color:#293b53;box-shadow:0 10px 26px rgba(0,0,0,.24),inset 0 1px 0 rgba(255,255,255,.025);}
html[data-theme="dark"] .noteBox:hover{border-color:rgba(24,201,106,.55);box-shadow:0 18px 38px rgba(0,0,0,.35),0 0 0 1px rgba(24,201,106,.12);}
html[data-theme="dark"] .noteText{color:#eef4fb;}.noteEmpty{color:#7f8ea4!important;}
html[data-theme="dark"] .noteEditor{background:rgba(16,27,43,.9);border-color:#2a3c55;box-shadow:0 16px 34px rgba(0,0,0,.3);}
html[data-theme="dark"] .noteEditor textarea{background:#0d1726;border-color:#2b3d55;color:#eef4fb;}
html[data-theme="dark"] .noteEditor textarea:focus{background:#101d2e;border-color:#18c96a;box-shadow:0 0 0 4px rgba(24,201,106,.12);}
</style>
